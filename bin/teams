#!/usr/bin/env python3
"""teams — launch/manage a set of Claude Code team sessions (programa, tmux, or commands to run yourself).

  teams up [--dry-run] [--resume]       one terminal per team (programa workspace / tmux window), claude started in each, primary selected
                                        --resume: re-attach to a running setup, restart dead sessions with exact --resume IDs
  teams status                          liveness per team, ticket summary, tail of shared/LOG.md
  teams cost                            token usage per team (lead vs workers, per model); $ if prices_per_mtok is set
  teams learn [team|all] [--force] [--dry-run] [--model m]   MANUAL: scan a team's repo once, one cheap LLM call → rules/<team>.md (cached by fingerprint)
  teams init [--dir .teams] [--language L] [--force] [repo...]   create a per-project instance: teams.json, role prompts, .gitignore (one team per detected app)
  teams msg <team> <text...>            type text into a team's terminal (fallback channel)
  teams task new|set|log|list|show      file-backed tickets in shared/tasks/ (used by the manager and the web board)
  teams board                           start the kanban web UI alone (teams up starts it automatically)
  teams down                            /exit every team, close their terminals, stop the board
  teams add <name> --cwd <dir> [--purpose "..."]   register a new team + prompt stub
  teams cmd <team>                      print the exact `claude` command for a team

Engine vs instance: this checkout is the ENGINE (code, default prompts, workers, board UI); put
bin/teams on your PATH once (see install.sh). A project holds one INSTANCE directory (.teams/ by
default: teams.json, its role prompts, rules/, shared/, .state/). The instance is found via --config,
$TEAMS_CONFIG, or by walking up from the cwd (.teams/teams.json, teams/teams.json, teams.json). Any
prompts/ or workers/ file present in the instance overrides the engine's. An instance that vendors
its own engine (git submodule at .teams/engine) is run with that engine automatically.
Terminals: `terminal` in teams.json = auto (default) | programa | tmux | manual — see bin/terminal.py.
"""
import argparse, json, os, re, shlex, shutil, signal, subprocess, sys, time
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import tasklib
import hooklib
import storage
import terminal

ENGINE = Path(__file__).resolve().parent.parent        # this checkout: code + default prompts/workers
SELF = Path(__file__).resolve()
VERSION = (ENGINE / "VERSION").read_text().strip() if (ENGINE / "VERSION").is_file() else "0"
CONFIG_CANDIDATES = (".teams/teams.json", "teams/teams.json", "teams.json")
# Instance paths — set by load() from the config location (tests assign them directly).
STATE = SESS = RULES = BOARD_STATE = BOARD_WS = None


def find_config() -> Path:
    """$TEAMS_CONFIG, else the first candidate found walking up from the cwd."""
    env = os.environ.get("TEAMS_CONFIG")
    if env:
        return Path(env)
    d = Path.cwd().resolve()
    for base in [d, *d.parents]:
        for rel in CONFIG_CANDIDATES:
            if (base / rel).is_file():
                return base / rel
    die("no teams.json found here or above — run `teams init` in your project, or `teams --config <file> <command>`")


def resource(cfg: dict, rel: str) -> Path:
    """Instance file if present, else the engine default."""
    for base in (cfg["_root"], ENGINE):
        if (base / rel).is_file():
            return base / rel
    die(f"file not found in instance or engine: {rel}")

SCAN_FILES = ["CLAUDE.md", ".claude/CLAUDE.md", "AGENTS.md", "README.md", "readme.md", "CONTRIBUTING.md",
              "package.json", "pyproject.toml", "composer.json", "go.mod", "Cargo.toml", "Gemfile", "requirements.txt",
              "tsconfig.json", "tailwind.config.js", "tailwind.config.ts", "tailwind.config.cjs", "postcss.config.js",
              "vite.config.ts", "vite.config.js", "next.config.js", "next.config.ts", "next.config.mjs", "nuxt.config.ts",
              "eslint.config.js", "eslint.config.mjs", ".eslintrc", ".eslintrc.json", ".eslintrc.cjs", ".prettierrc", ".prettierrc.json",
              ".editorconfig", "ruff.toml", "setup.cfg", "pytest.ini", "Makefile", "docker-compose.yml", "Dockerfile", ".env.example"]
SCAN_SKIP = {"node_modules", ".git", "dist", "build", ".next", ".nuxt", ".venv", "venv", "__pycache__", "vendor", "coverage", ".turbo", ".cache", "target"}
LEARN_PROMPT = """You are extracting the coding rules of ONE repository for AI coding agents that will edit it.
Below is a snapshot: key files and dependency list. Produce a digest in EXACTLY this format, in English, max 60 lines total, bullets only, no prose, no headings other than these:

STACK: one line (language, framework, styling/animation/state libs, db, package manager)
COMMANDS:
- run: <cmd> | test: <cmd> | lint: <cmd> | build: <cmd> | format: <cmd>   (only those that exist; say "unknown" if not found)
STRUCTURE: (max 6 lines, only if the docs describe it) where routes/pages, components, models, tests live — path: role; else one line "unknown"
CONVENTIONS: (max 15 lines) only rules that change how code is written: naming, styling approach (e.g. utility classes vs css modules, fluid type helpers), animation lib, state management, data fetching pattern, error handling, typing strictness, i18n, commit/PR conventions if stated
NEVER: (max 5 lines) explicit prohibitions found in docs/config (e.g. no inline styles, no default exports, no raw fetch)
SEE: (max 3 lines) files worth reading before coding, e.g. "CLAUDE.md §Styling", "docs/adr/…" — point, do not copy

Rules: prefer what CLAUDE.md/README/AGENTS.md state over what you infer. If CLAUDE.md exists, do NOT repeat its content — reference it in SEE and only add what it lacks. No speculation: if unknown, write "unknown". Output the digest and nothing else."""


# ---------- config -----------------------------------------------------------
def load(cfg_path: Path) -> dict:
    global STATE, SESS, RULES, BOARD_STATE, BOARD_WS
    cfg_path = cfg_path.resolve()
    cfg = json.loads(cfg_path.read_text())
    cfg["_path"] = cfg_path
    cfg["_root"] = cfg_path.parent
    STATE = cfg['_root'] / '.state' / 'terminal.json'     # driver + one handle per team while up
    SESS = STATE.parent / 'sessions'
    RULES = cfg['_root'] / 'rules'
    BOARD_STATE = STATE.parent / 'board.json'
    BOARD_WS = STATE.parent / 'board-tab.json'            # terminal handle hosting the board server
    cfg.setdefault("language", "English")
    if cfg.get("terminal", "auto") not in ("auto", *terminal.NAMES):
        die(f"terminal must be one of auto, {', '.join(terminal.NAMES)}")
    cfg["shared_abs"] = (cfg["_root"] / cfg.get("shared_dir", "shared")).resolve()
    cfg["teams"] = [t for t in cfg["teams"] if t.get("enabled", True)]
    cfg.setdefault("defaults", {})
    runners = cfg.setdefault("runners", {"claude": {"command": "claude"}})
    seen = set()
    for t in cfg["teams"]:
        t["runner_name"] = t.get("runner", cfg["defaults"].get("runner", "claude"))
        if t["runner_name"] not in runners:
            die(f"unknown runner {t['runner_name']!r} for team {t['name']} (define it under \"runners\")")
        t["runner"] = runners[t["runner_name"]]
        if not re.fullmatch(r"[a-z0-9-]+", t["name"]):
            die(f"team name must be [a-z0-9-]: {t['name']}")
        if t["name"] in seen:
            die(f"duplicate team: {t['name']}")
        seen.add(t["name"])
        t["cwd_abs"] = (cfg["_root"] / t["cwd"]).resolve()
        if not t["cwd_abs"].is_dir():
            die(f"cwd not found for {t['name']}: {t['cwd_abs']}")
        t["prompt_abs"] = resource(cfg, f"prompts/{t.get('prompt', t['name'] + '.md')}")
    primaries = [t for t in cfg["teams"] if t.get("primary")]
    if len(primaries) != 1:
        die("exactly one team must have \"primary\": true")
    return cfg


def check_engine_version(cfg: dict):
    """Only on `up`: agents run `teams task …` all day and must not see this warning in every output."""
    want = str(cfg.get("engine_version", ""))
    if want and want != VERSION:
        print(f"teams: instance was created for engine {want}, this engine is {VERSION} — check the changelog", file=sys.stderr)


def die(msg: str, code: int = 1):
    print(f"teams: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------- prompt / agents assembly -----------------------------------------
def parse_agent_md(path: Path) -> tuple[str, dict]:
    text = path.read_text()
    m = re.match(r"^---\n(.*?)\n---\n(.*)$", text, re.S)
    if not m:
        die(f"agent file missing frontmatter: {path}")
    meta = {}
    for line in m.group(1).splitlines():
        k, _, v = line.partition(":")
        meta[k.strip()] = v.strip()
    return meta.pop("name", path.stem), {**meta, "prompt": m.group(2).strip()}


def resolve_workers(cfg: dict, team: dict) -> dict:
    """Merge defaults.workers with team.workers. Entry: dict | model-string | False (remove)."""
    def norm(v):
        return {"model": v} if isinstance(v, str) else v
    base = {} if team.get("workers_replace") else {k: dict(norm(v)) for k, v in cfg["defaults"].get("workers", {}).items() if v is not False}
    for k, v in (team.get("workers") or {}).items():
        if v is False:
            base.pop(k, None)
            continue
        merged = {**base.get(k, {}), **norm(v)}
        merged["vars"] = {**base.get(k, {}).get("vars", {}), **norm(v).get("vars", {})}
        base[k] = merged
    return base


def render(text: str, vars: dict, where: str = "") -> str:
    for k, v in vars.items():
        text = text.replace("{{" + k + "}}", str(v))
    missing = re.findall(r"{{(\w+)}}", text)
    if missing:
        die(f"unset template vars {sorted(set(missing))}{' in ' + where if where else ''} — available: {', '.join(sorted(vars))}"
            + ("" if where else " (worker prompts: set extra ones under workers.<name>.vars in teams.json)"))
    return text


def worker_specs(cfg: dict, team: dict) -> dict:
    """name -> full agent spec (description, prompt, model, ...) ready for --agents."""
    specs = {}
    for name, w in resolve_workers(cfg, team).items():
        f = resource(cfg, w.get("file", f"workers/{name}.md"))
        _, spec = parse_agent_md(f)
        for k in ("model", "description"):
            if w.get(k):
                spec[k] = w[k]
        rules = "\n".join(x for x in [rules_sections(team["name"]), rules_local(team["name"])] if x)
        vars = {"team": team["name"], "cwd": str(team["cwd_abs"]), "shared_dir": str(cfg["shared_abs"]),
                "language": cfg["language"],
                "rules": ("REPO RULES (follow strictly; CLAUDE.md wins on conflict):\n" + rules) if rules else "", **w.get("vars", {})}
        spec["prompt"] = render(spec["prompt"], vars)
        spec["description"] = render(spec.get("description", ""), vars)
        specs[name] = spec
    if not specs:
        die(f"team {team['name']} has no workers")
    return specs


def build_agents_json(cfg: dict, team: dict) -> str:
    return json.dumps(worker_specs(cfg, team), ensure_ascii=False)


def workers_text(cfg: dict, team: dict) -> str:
    lines = ["# WORKERS available to you (Agent tool, subagent_type = name)"]
    brain = team["runner"].get("brain")
    if brain:
        lines.append(f"(this team runs on {brain}: every worker below actually thinks with that model, whatever its nominal model)")
    for name, spec in worker_specs(cfg, team).items():
        lines.append(f"- `{name}` ({spec.get('model','?')}): {spec.get('description','')}")
    return "\n".join(lines)


def roster_text(cfg: dict, me: dict) -> str:
    lines = [f"# ROSTER  (you are: {me['name']})", f"SHARED_DIR: {cfg['shared_abs']}", ""]
    for t in cfg["teams"]:
        tag = " ← you" if t is me else ""
        brain = t["runner"].get("brain") or t.get("model", cfg["defaults"].get("model", "claude-fable-5-1"))
        stack = rules_stack(t["name"])
        lines.append(f"- {t['name']}{' (primary)' if t.get('primary') else ''} [{brain}]: {t.get('purpose','')}  cwd={t['cwd_abs']}{tag}"
                     + (f"\n    stack: {stack}" if stack else ""))
    return "\n".join(lines)


def system_prompt(cfg: dict, team: dict) -> str:
    rules = "\n\n".join(x for x in [
        ("# REPO RULES (digest generated by `teams learn`; CLAUDE.md in the repo wins on any conflict)\n" + rules_digest(team["name"])) if rules_digest(team["name"]) else "",
        ("# LOCAL RULES (hand-written, authoritative)\n" + rules_local(team["name"])) if rules_local(team["name"]) else "",
    ] if x)
    vars = {"team": team["name"], "cwd": str(team["cwd_abs"]), "shared_dir": str(cfg["shared_abs"]),
            "root": str(cfg["_root"]), "engine": str(ENGINE), "language": cfg["language"],
            "teams": teams_command(cfg)}
    parts = [
        render(resource(cfg, "prompts/_common.md").read_text(), vars, "prompts/_common.md"),
        workers_text(cfg, team),
        render(team["prompt_abs"].read_text(), vars, str(team["prompt_abs"])),
        rules,
        roster_text(cfg, team),
        render(resource(cfg, "prompts/PROTOCOL.md").read_text(), vars, "prompts/PROTOCOL.md"),
    ]
    return "\n\n".join(p.strip() for p in parts)


def teams_command(cfg: dict) -> str:
    """How prompts refer to this CLI: bare `teams` when it is on the PATH, else an explicit path.
    Sessions inherit TEAMS_CONFIG, so no --config is needed inside them."""
    found = shutil.which("teams")
    if found and Path(found).resolve() == SELF:
        return "teams"
    return str(SELF)


def claude_cmd(cfg: dict, team: dict) -> list[str]:
    prompt_file = cfg['_root'] / ".state" / f"prompt-{team['name']}.md"
    prompt_file.parent.mkdir(exist_ok=True)
    prompt_file.write_text(system_prompt(cfg, team))
    agents_file = cfg['_root'] / '.state' / f"workers-{team['name']}.json"
    agents_file.write_text(build_agents_json(cfg, team))
    runner = team["runner"]
    cmd = [runner.get("command", "claude"), "-n", team["name"],
           "--model", team.get("model", cfg["defaults"].get("model", "claude-fable-5-1")),
           "--append-system-prompt-file", str(prompt_file),
           "--agents", f"$(cat {shlex.quote(str(agents_file))})",
           "--add-dir", str(cfg["shared_abs"])]
    for d in [*cfg["defaults"].get("add_dirs", []), *team.get("add_dirs", [])]:
        cmd += ["--add-dir", str((cfg["_root"] / d).resolve())]
    cmd += ["--settings", hook_settings_json(cfg, team)]
    pm = team.get("permission_mode", cfg.get("permission_mode"))
    if pm == "yolo":
        cmd.append("--dangerously-skip-permissions")
    elif pm:
        cmd += ["--permission-mode", pm]
    for flag in runner.get("drop_flags", []):          # runners that set their own model/effort
        while flag in cmd:
            i = cmd.index(flag); del cmd[i:i + 2]
    return ['env', f"TEAMS_TEAM={team['name']}", f"TEAMS_CONFIG={cfg['_path']}", *cmd]


def hook_settings_json(cfg: dict, team: dict) -> str:
    hook = (f"TEAMS_TEAM={shlex.quote(team['name'])} "
            f"TEAMS_CONFIG={shlex.quote(str(cfg['_path']))} "
            f"TEAMS_RUN={shlex.quote(hooklib.run_id(cfg['_root']) or '')} python3 {shlex.quote(str(SELF))} _hook")
    def entry(matcher=''):
        return [{"matcher": matcher, "hooks": [{"type": "command", "command": hook, "timeout": 5}]}]
    return json.dumps({"hooks": {
        "SessionStart": entry(), "UserPromptSubmit": entry(), "Stop": entry(), "SessionEnd": entry(),
        "PreToolUse": entry('SendMessage'), "PostToolUse": entry('SendMessage'),
        "PostToolUseFailure": entry('SendMessage'),
    }})


def cmd_hook():
    event = {}
    try:
        event = json.loads(sys.stdin.read() or '{}')
        warning = hooklib.handle(Path(os.environ.get('TEAMS_CONFIG') or find_config()),
                                 os.environ.get('TEAMS_TEAM', '?'), event,
                                 os.environ.get('TEAMS_RUN') or None)
        print(json.dumps({'systemMessage': warning} if warning else {}))
    except (OSError, ValueError, KeyError, StopIteration) as exc:
        if event.get('hook_event_name') == 'PreToolUse':
            print(f'teams: {exc}', file=sys.stderr)
            sys.exit(2)
        print(json.dumps({'systemMessage': f'teams event could not be applied: {exc}'}))


def pretrust(cfg: dict):
    """Mark every team cwd as trusted in ~/.claude.json so no 'trust this folder' dialog blocks a pane."""
    path = Path.home() / ".claude.json"
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return
    projects = data.setdefault("projects", {})
    changed = False
    for t in cfg["teams"]:
        entry = projects.setdefault(str(t["cwd_abs"]), {})
        if not entry.get("hasTrustDialogAccepted"):
            entry["hasTrustDialogAccepted"] = True
            changed = True
    if changed:
        path.write_text(json.dumps(data, indent=2, ensure_ascii=False))


def shell_line(cmd: list[str]) -> str:
    # keep the $(cat ...) unquoted so the shell expands it
    return " ".join(f'"{c}"' if c.startswith("$(") else shlex.quote(c) for c in cmd)


# ---------- rules (manual: teams learn / teams init) -------------------------
def _read_cap(p: Path, cap: int = 6000) -> str:
    try:
        t = p.read_text(errors="replace")
    except OSError:
        return ""
    return t if len(t) <= cap else t[:cap] + f"\n… [truncated {len(t)-cap} chars]"


def scan_repo(root: Path) -> dict:
    files = {}
    for rel in SCAN_FILES:
        p = root / rel
        if p.is_file():
            files[rel] = _read_cap(p)
    deps = []
    pj = root / "package.json"
    if pj.is_file():
        try:
            j = json.loads(pj.read_text())
            deps += sorted({**j.get("dependencies", {}), **j.get("devDependencies", {})})
        except json.JSONDecodeError:
            pass
    py = root / "pyproject.toml"
    if py.is_file():
        txt = py.read_text(errors="replace")
        for block in re.findall(r'dependencies\s*=\s*\[(.*?)\]', txt, re.S):
            deps += [m.lower() for m in re.findall(r'["\']([A-Za-z0-9_.-]+)', block)]
        deps += [m.lower() for m in re.findall(r'^([A-Za-z0-9_.-]+)\s*=\s*[\'"^~>=<{]', txt, re.M) if m not in ("name", "version", "description", "readme", "python")]
    return {"files": files, "deps": deps}


def fingerprint(root: Path) -> str:
    import hashlib
    h = hashlib.sha256()
    for rel in SCAN_FILES:
        p = root / rel
        if p.is_file():
            h.update(rel.encode()); h.update(p.read_bytes())
    return h.hexdigest()[:16]


def rules_paths(name: str) -> tuple[Path, Path]:
    return RULES / f"{name}.md", RULES / f"{name}.local.md"


def rules_fingerprint(name: str) -> str | None:
    f, _ = rules_paths(name)
    if not f.is_file():
        return None
    m = re.search(r"fingerprint: ([0-9a-f]+)", f.read_text())
    return m.group(1) if m else None


def rules_digest(name: str) -> str:
    """Generated digest without the header comment (empty if none)."""
    f, _ = rules_paths(name)
    if not f.is_file():
        return ""
    return re.sub(r"^<!--.*?-->\s*", "", f.read_text(), flags=re.S).strip()


def rules_local(name: str) -> str:
    _, l = rules_paths(name)
    return l.read_text().strip() if l.is_file() else ""


def rules_sections(name: str, wanted=("COMMANDS", "CONVENTIONS", "NEVER")) -> str:
    """Subset of the digest for workers (they write code; they don't need STRUCTURE/SEE)."""
    out, keep = [], False
    for line in rules_digest(name).splitlines():
        m = re.match(r"^([A-Z]+):", line)
        if m:
            keep = m.group(1) in wanted
        if keep:
            out.append(line)
    return "\n".join(out)


def rules_stack(name: str) -> str:
    m = re.search(r"^STACK:\s*(.+)$", rules_digest(name), re.M)
    return m.group(1).strip() if m else ""


def cmd_learn(cfg: dict, a):
    targets = [t for t in cfg["teams"] if not t.get("primary")] if a.team == "all" else [t for t in cfg["teams"] if t["name"] == a.team]
    if not targets:
        die(f"unknown team {a.team}")
    RULES.mkdir(exist_ok=True)
    for t in targets:
        root = t["cwd_abs"]
        fp = fingerprint(root)
        f, _ = rules_paths(t["name"])
        if f.is_file() and rules_fingerprint(t["name"]) == fp and not a.force:
            print(f"[{t['name']}] rules up to date ({fp}) — use --force to regenerate"); continue
        snap = scan_repo(root)
        if not snap["files"] and not snap["deps"]:
            print(f"[{t['name']}] nothing to learn in {root} (no manifest/README/CLAUDE.md)"); continue
        body = [f"REPO: {root}", "", "## DEPENDENCIES", ", ".join(snap["deps"]) or "(none)", ""]
        for rel, txt in snap["files"].items():
            body += [f"## FILE {rel}", txt, ""]
        prompt = LEARN_PROMPT + "\n\n" + "\n".join(body)
        if a.dry_run:
            print(f"[{t['name']}] would send ~{len(prompt)//4:,} tokens to {a.model} ({len(snap['files'])} files, {len(snap['deps'])} deps)"); continue
        print(f"[{t['name']}] learning from {root} (~{len(prompt)//4:,} tokens → {a.model}) …")
        try:
            r = subprocess.run(["claude", "-p", "--model", a.model, "--tools", "", "--no-session-persistence", "--output-format", "text"],
                               input=prompt, capture_output=True, text=True, cwd=str(root), timeout=300)
        except subprocess.TimeoutExpired:
            print(f"[{t['name']}] FAILED: no answer from {a.model} after 5 minutes"); continue
        if r.returncode != 0 or not r.stdout.strip():
            print(f"[{t['name']}] FAILED: {r.stderr.strip()[:300]}"); continue
        digest = "\n".join(r.stdout.strip().splitlines()[:70])
        f.write_text(f"<!-- generated by `teams learn` — fingerprint: {fp} — {datetime.now():%Y-%m-%d %H:%M} — model: {a.model} — do not edit; put your own rules in {t['name']}.local.md -->\n{digest}\n")
        print(f"[{t['name']}] wrote {f.relative_to(cfg['_root'])} ({len(digest.splitlines())} lines)")



def check_rules_fresh(cfg: dict):
    for t in cfg["teams"]:
        if t.get("primary"):
            continue
        have = rules_fingerprint(t["name"])
        if have is None:
            print(f"[{t['name']}] no rules digest — `teams learn {t['name']}` (manual, optional)")
        elif have != fingerprint(t["cwd_abs"]):
            print(f"[{t['name']}] rules digest is STALE (repo config changed) — `teams learn {t['name']} --force`")


def detect_apps(roots: list) -> list:
    """(kind, dir) for every frontend/backend app found under the given roots (2 levels deep)."""
    FRONT = {"react", "vue", "svelte", "next", "nuxt", "@angular/core", "solid-js", "astro", "vite"}
    BACK = {"fastapi", "django", "flask", "express", "@nestjs/core", "hono", "koa", "fastify", "laravel/framework", "rails", "gin"}
    apps, seen_dirs, manifests = [], set(), []
    for r in roots:
        for pat in ("package.json", "*/package.json", "*/*/package.json", "pyproject.toml", "*/pyproject.toml", "*/*/pyproject.toml",
                    "composer.json", "*/composer.json"):
            manifests += list(r.glob(pat))
    for pj in manifests:
        if any(part in SCAN_SKIP for part in pj.parts) or pj.parent in seen_dirs:
            continue
        seen_dirs.add(pj.parent)
        deps = set(scan_repo(pj.parent)["deps"])
        kind = "frontend" if deps & FRONT else "backend" if deps & BACK else None
        if kind:
            apps.append((kind, pj.parent))
    return apps


def cmd_init(a):
    """Create a per-project instance directory (never overwrites without --force)."""
    inst = Path(a.dir).resolve()
    out = inst / "teams.json"
    if out.exists() and not a.force:
        die(f"{out} exists — use --force to overwrite, or --dir <other>")
    project = inst.parent
    roots = [Path(r).resolve() for r in a.repo] or [project]
    for r in roots:
        if not r.is_dir():
            die(f"not a directory: {r}")
    root = Path(os.path.commonpath([str(r) for r in roots])) if len(roots) > 1 else roots[0]   # manager's cwd
    apps = detect_apps(roots)
    rel = lambda d: os.path.relpath(d, inst)
    manager = {"name": "manager", "title": "Manager", "primary": True, "cwd": rel(root), "prompt": "manager.md",
               "purpose": "Plans with the human, dispatches to the other teams, verifies the result. Never codes.", "add_dirs": []}
    teams, seen = [manager], {}
    for kind, d in apps:
        n = kind if kind not in seen else f"{kind}-{d.name}"
        seen[kind] = seen.get(kind, 0) + 1
        teams.append({"name": n, "title": n.capitalize(), "cwd": rel(d), "prompt": f"{n}.md", "purpose": f"{kind} ({d.name})"})
        if d != root:
            manager["add_dirs"].append(rel(d))
    if not apps:
        teams.append({"name": "dev", "title": "Dev", "cwd": rel(root), "prompt": "dev.md",
                      "purpose": "Implements everything in this repository."})
    cfg = {"$doc": ["Generated by `teams init` — review cwd/titles/workers, edit prompts/*.md, then `teams learn all` (optional) and `teams up`.",
                    "Paths are relative to this file. Any prompts/ or workers/ file here overrides the engine default of the same name."],
           "engine_version": VERSION, "language": a.language,
           "shared_dir": "shared", "permission_mode": "yolo", "trust_dirs": True, "terminal": "auto",
           "board": {"port": 0, "ref_base_url": ""},
           "shell_prompt_regex": "(➜|→|❯|\\$|%|#) ",
           "runners": {"claude": {"command": "claude"}},
           "defaults": {"model": "claude-fable-5-1", "runner": "claude", "add_dirs": [],
                        "workers": {"worker-simple": {"model": "claude-sonnet-5"}, "worker-complex": {"model": "claude-opus-5"}}},
           "teams": teams}
    # skeleton: template files + role prompts copied from the engine so the user can edit them
    for src in (ENGINE / "template").rglob("*"):
        if src.is_file():
            dst = inst / src.relative_to(ENGINE / "template")
            dst.parent.mkdir(parents=True, exist_ok=True)
            if not dst.exists() or a.force:
                dst.write_bytes(src.read_bytes())
    (inst / "prompts").mkdir(exist_ok=True)
    for t in teams:
        dst = inst / "prompts" / t["prompt"]
        if dst.exists() and not a.force:
            continue
        kind = t["name"].split("-")[0]
        src = ENGINE / "prompts" / f"{kind}.md"
        text = src.read_text() if src.is_file() else (ENGINE / "prompts" / "_template.md").read_text().replace("<TEAM NAME>", t["name"].upper())
        dst.write_text(text)
    out.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")
    cli = teams_command(cfg)
    shown = inst.relative_to(Path.cwd()) if inst.is_relative_to(Path.cwd()) else inst
    where = (f"from anywhere inside {project}" if inst.name in (".teams", "teams")
             else f"with `export TEAMS_CONFIG={out}` (a `{inst.name}/` directory is not found automatically)")
    print(f"wrote {out}\n" + "\n".join(f"  {t['name']:12} {t['cwd']}" for t in teams)
          + f"\nnext: edit {shown}/prompts/*.md, then `{cli} learn all` (optional) and `{cli} up` {where}")


# ---------- terminal state ---------------------------------------------------
def load_state() -> dict:
    return json.loads(STATE.read_text()) if STATE.exists() else {}


def save_state(d: dict):
    STATE.parent.mkdir(exist_ok=True)
    STATE.write_text(json.dumps(d, indent=2))


def driver_for(cfg: dict, state: dict | None = None) -> terminal.Driver:
    """The driver recorded by `up` while the teams are up, else the configured / auto-detected one."""
    st = load_state() if state is None else state
    if st.get("driver"):
        return terminal.driver(st["driver"], cfg, cfg["_root"])
    return terminal.detect(cfg, cfg["_root"])


def write_roster_json(cfg: dict):
    data = {"shared_dir": str(cfg["shared_abs"]),
            "teams": {t["name"]: {"cwd": str(t["cwd_abs"]), "primary": bool(t.get("primary")), "purpose": t.get("purpose", "")}
                      for t in cfg["teams"]}}
    (cfg["shared_abs"] / ".roster.json").write_text(json.dumps(data, indent=2))


def preflight_runners(cfg: dict):
    """For every runner in use with a healthcheck URL: ensure it answers, else run its start command and wait."""
    import time, urllib.request, urllib.error
    def alive(url):
        try:
            urllib.request.urlopen(url, timeout=2); return True
        except urllib.error.HTTPError:
            return True                       # 401/404 = something answers
        except Exception:
            return False
    for name in {t["runner_name"] for t in cfg["teams"]}:
        r = cfg["runners"][name]
        url = r.get("healthcheck")
        if not url or alive(url):
            continue
        if not r.get("start"):
            die(f"runner {name}: {url} does not answer and no `start` command is configured")
        print(f"[{name}] {url} down → {r['start']}")
        subprocess.run(r["start"], shell=True, check=False)
        for _ in range(15):
            time.sleep(1)
            if alive(url):
                break
        else:
            die(f"runner {name}: still no answer at {url} after start")


# ---------- commands ---------------------------------------------------------
def cmd_up(cfg: dict, a):
    check_engine_version(cfg)
    if not a.dry_run and cfg.get("trust_dirs", True):
        pretrust(cfg)
    check_rules_fresh(cfg)
    if not a.dry_run:
        preflight_runners(cfg)
    primary = next(t for t in cfg["teams"] if t.get("primary"))
    ordered = [t for t in cfg["teams"] if not t.get("primary")] + [primary]   # primary last -> ends up selected
    drv = driver_for(cfg)
    if a.dry_run or drv.name == "manual":
        if not a.dry_run and not a.resume:
            if load_state():
                die("teams already up; use --resume or teams down first")
            hooklib.begin_run(cfg["_root"])
            save_state({"driver": "manual", "handles": {}, "started_at": datetime.now().isoformat(timespec="seconds")})
        if not a.dry_run:
            print("No programa or tmux here — run these yourself, one per terminal:\n")
        for t in ordered:
            print(f"# {t['name']}  (cd {t['cwd_abs']})")
            command = claude_cmd(cfg, t)
            if a.resume and session_info(t["name"]).get("session_id"):
                command += ["--resume", session_info(t["name"])["session_id"]]
            print(shell_line(command), "\n")
        write_roster_json(cfg)
        if not a.dry_run:
            start_board(cfg)
        return
    if a.resume:
        return cmd_resume(cfg, ordered, primary)
    if load_state():
        die("teams already up (see .state/terminal.json) - run `teams down` first, or `teams up --resume`")
    (cfg["shared_abs"] / "LOG.md").touch()
    with open(cfg["shared_abs"] / "LOG.md", "a") as fh:
        fh.write(f"\n## up {datetime.now():%Y-%m-%d %H:%M}\n")
    # 1) one terminal per team, all recorded before any claude starts
    handles = {}
    for t in ordered:
        h = drv.open(t["name"], t.get("title", t["name"]), t["cwd_abs"], t.get("purpose", ""))
        if not h:
            for opened in handles.values():          # leave nothing behind that `down` cannot see
                drv.close(opened)
            die(f"{drv.name}: could not open a terminal for {t['name']}")
        handles[t["name"]] = h
        print(f"[{t['name']}] {drv.describe(h)}")
    save_state({"driver": drv.name, "handles": handles, "started_at": datetime.now().isoformat(timespec="seconds")})
    write_roster_json(cfg)
    hooklib.begin_run(cfg["_root"])
    # 2) launch claude in each terminal (after its shell prompt is up)
    for t in ordered:
        drv.wait_ready(handles[t["name"]])
        if not drv.send(handles[t["name"]], shell_line(claude_cmd(cfg, t)) + "\n"):
            die(f"{drv.name}: could not type into {t['name']}'s terminal")
    start_board(cfg)
    drv.select(handles[primary["name"]])
    hint = drv.attach_hint()
    print(f"\n{primary['name']} is selected - talk to it there. `teams down` closes everything." + (f"\n{hint}" if hint else ""))


def session_info(name: str) -> dict:
    f = SESS / f"{name}.json"
    try:
        return json.loads(f.read_text()) if f.exists() else {}
    except json.JSONDecodeError:
        return {}


def process_alive(cfg: dict, name: str) -> bool:
    """Alive = a claude process runs on the team's terminal tty (robust to the terminal rewriting argv / --continue)."""
    st = load_state()
    h = st.get("handles", {}).get(name)
    tty = driver_for(cfg, st).tty(h) if h else None
    if tty:
        r = subprocess.run(["ps", "-t", tty, "-o", "command="], capture_output=True, text=True)
        return any("/claude" in l or l.startswith("claude") for l in r.stdout.splitlines())
    return session_info(name).get("status") in ("idle", "working")     # no tty (manual driver): trust the hooks


def plan_summary(cfg: dict) -> str:
    f = cfg["shared_abs"] / "PLAN.md"
    title = ""
    if f.exists():
        title = next((l[2:].strip() for l in f.read_text().splitlines() if l.startswith("# ")), "")
    return (f"{title} — " if title else "") + tasklib.summary(cfg["shared_abs"])


# ---------- board (kanban web UI) --------------------------------------------
BOARD_BIN = Path(__file__).resolve().parent / "teams-board"
# BOARD_STATE (.state/board.json) and BOARD_WS (.state/board-tab.json) are set by load(); the board tab handle is kept apart from .state/terminal.json so the `up` guard on terminal.json stays valid.


def board_state() -> dict:
    try:
        return json.loads(BOARD_STATE.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def board_alive(st: dict | None = None) -> bool:
    pid = (st if st is not None else board_state()).get("pid")
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def board_tab_state() -> dict:
    try:
        return json.loads(BOARD_WS.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def start_board(cfg: dict, port: int | None = None):
    """Start the board server. With programa it MUST live in a real pane (a detached process gets
    'Broken pipe' from `programa send`, so it could never wake the manager): it runs as an extra
    tab in the manager's pane. tmux gets a window too (logs stay visible). Otherwise: detached
    subprocess (board usable, no wake)."""
    st = board_state()
    if board_alive(st):
        print(f"board → {st.get('url')} (already running)")
        return
    BOARD_STATE.parent.mkdir(exist_ok=True)
    BOARD_STATE.unlink(missing_ok=True)
    cmd = [sys.executable, str(BOARD_BIN), "--root", str(cfg['_root']), '--config', str(cfg['_path'])] + (["--port", str(port)] if port is not None else [])
    drv = driver_for(cfg)
    if drv.board_in_terminal and drv.available():
        tab = board_tab_state()
        if not (tab and drv.exists(tab)):
            primary = next(t["name"] for t in cfg["teams"] if t.get("primary"))
            tab = drv.open_tab(load_state().get("handles", {}).get(primary), "board", cfg["_root"])
            if not tab:
                die(f"{drv.name}: could not open a tab for the board")
            BOARD_WS.write_text(json.dumps(tab, indent=2))
        drv.wait_ready(tab)
        drv.send(tab, f"cd {shlex.quote(str(cfg['_root']))} && clear && " + shell_line(cmd) + "\n")
    else:
        log = open(cfg['_root'] / ".state" / "board.log", "ab")
        subprocess.Popen(cmd, stdout=log, stderr=log, start_new_session=True)
    for _ in range(60):
        time.sleep(0.1)
        st = board_state()
        if st.get("url") and board_alive(st):
            print(f"board → {st['url']}")
            return
    print("board: failed to start — see the board tab next to the manager (or .state/board.log)")


def stop_board():
    st = board_state()
    if st.get("pid"):
        try:
            os.kill(st["pid"], signal.SIGTERM)
            print(f"board stopped ({st.get('url','')})")
        except OSError:
            pass
    BOARD_STATE.unlink(missing_ok=True)
    # the tab itself is left as a plain shell; `teams down` closes it with the team terminals


def cmd_board(cfg: dict, a):
    start_board(cfg, port=a.port)


# ---------- tickets (teams task …) -------------------------------------------
def cmd_task(cfg: dict, a):
    sh = cfg["shared_abs"]
    identity = {"actor": os.environ.get("TEAMS_TEAM", "human"),
                "primary": next(t["name"] for t in cfg["teams"] if t.get("primary"))}
    names = [t['name'] for t in cfg['teams']]
    if a.tcmd == "new":
        t = tasklib.create(sh, " ".join(a.title), team=a.team or "-", status=a.status, ref=a.ref or "",
                           description=a.desc or "", criteria=a.criteria or "", by=identity["actor"],
                           primary=identity["primary"], teams=names, scope=a.scope or "",
                           verify=a.verify or "", decisions=a.decisions or "", depends=a.depends or "")
        print(t["id"])
    elif a.tcmd == "set":
        changes = {}
        for pair in a.pairs:
            k, sep, v = pair.partition("=")
            if not sep or k not in tasklib.EDITABLE:
                die(f"task set: expected key=value with key in {sorted(tasklib.EDITABLE)}, got {pair!r}")
            changes[k] = v
        t = tasklib.update(sh, a.id, changes, **identity, teams=names)
        print(f"{t['id']} {t['status']}{' ⛔' if t['blocked'] else ''} [{t['team']}]")
    elif a.tcmd == "log":
        tasklib.append_log(sh, a.id, " ".join(a.text), **identity)
        print("ok")
    elif a.tcmd == "list":
        ts = tasklib.load_all(sh)
        if a.status:
            ts = [t for t in ts if t["status"] == a.status]
        for t in ts:
            print(f"{t['id']:4} {t['status']:7}{'⛔' if t['blocked'] else ' '} [{t['team']}] {t['title']}"
                  + (f"  ({t['ref']})" if t['ref'] else ""))
        if not ts:
            print("(no tickets)")
    elif a.tcmd == "show":
        p = tasklib.path_of(sh, a.id)
        if not p.is_file():
            die(f"unknown ticket {a.id}")
        print(p.read_text(), end="")


def cmd_status(cfg: dict, a):
    st = load_state()
    if not st:
        print("teams: down (no state). `teams up` to start.")
        bst = board_state()
        if board_alive(bst):
            print(f"board → {bst.get('url')}")
        print("\n" + plan_summary(cfg))
        return
    print(f"up since {st.get('started_at','?')}  ({st.get('driver','?')})\n")
    drv = driver_for(cfg, st)
    for t in cfg["teams"]:
        si = session_info(t["name"])
        alive = process_alive(cfg, t["name"])
        state = si.get("status", "?") if alive else "DEAD"
        h = st.get("handles", {}).get(t["name"])
        where = drv.describe(h) if h else "?"
        print(f"  {t['name']:10} {state:8} {where:24} last {si.get('updated','-')[11:]:8} session {str(si.get('session_id','-'))[:8]}")
    bst = board_state()
    print(f"  {'board':10} {'up' if board_alive(bst) else 'DEAD':8} {bst.get('url','-')}")
    print("\n" + plan_summary(cfg))
    log = cfg["shared_abs"] / "LOG.md"
    if log.exists():
        lines = [l for l in log.read_text().splitlines() if l.strip()]
        print("\nLOG.md (last 12):\n  " + "\n  ".join(lines[-12:]))


def cmd_resume(cfg: dict, ordered: list, primary: dict):
    """Re-attach to an existing `up`: recreate missing terminals, restart dead sessions with exact --resume IDs."""
    st = load_state()
    if not st:
        die("nothing to resume (no state) — run `teams up`")
    drv = driver_for(cfg, st)
    handles = st.get("handles", {})
    for t in ordered:
        n = t["name"]
        if not handles.get(n) or not drv.exists(handles[n]):
            h = drv.open(n, t.get("title", n), t["cwd_abs"], t.get("purpose", ""))
            if not h:
                die(f"{drv.name}: could not open a terminal for {n}")
            handles[n] = h
            print(f"[{n}] terminal recreated {drv.describe(h)}")
    save_state({**st, "driver": drv.name, "handles": handles})
    write_roster_json(cfg)
    for t in ordered:
        n = t["name"]
        if process_alive(cfg, n):
            print(f"[{n}] alive — untouched")
            continue
        cmd = claude_cmd(cfg, t)
        sid = session_info(n).get('session_id')
        if sid:
            cmd += ['--resume', sid]
        drv.wait_ready(handles[n])
        if not drv.send(handles[n], shell_line(cmd) + "\n"):
            die(f"{drv.name}: could not type into {n}'s terminal")
        print(f"[{n}] restarted with --resume {sid}" if sid else f"[{n}] started a fresh session (no recorded id)")
    with open(cfg["shared_abs"] / "LOG.md", "a") as fh:
        fh.write(f"\n## resume {datetime.now():%Y-%m-%d %H:%M}\n")
    start_board(cfg)
    drv.select(handles[primary["name"]])


def usage_of(path: Path) -> dict:
    """Aggregate token usage of one transcript by model, deduping streamed chunks by message id."""
    seen, out = {}, {}
    try:
        for line in open(path):
            try:
                d = json.loads(line)
            except json.JSONDecodeError:
                continue
            m = d.get("message") or {}
            if d.get("type") != "assistant" or "usage" not in m:
                continue
            seen[m.get("id") or d.get("uuid")] = (m.get("model", "?"), m["usage"])
    except OSError:
        return out
    for model, u in seen.values():
        o = out.setdefault(model, {"in": 0, "out": 0, "cache_read": 0, "cache_write": 0, "msgs": 0})
        o["in"] += u.get("input_tokens", 0); o["out"] += u.get("output_tokens", 0)
        o["cache_read"] += u.get("cache_read_input_tokens", 0); o["cache_write"] += u.get("cache_creation_input_tokens", 0)
        o["msgs"] += 1
    return out


def cmd_cost(cfg: dict, a):
    prices = cfg.get("prices_per_mtok", {})          # {model: {"in":x,"out":y,"cache_read":z,"cache_write":w}}
    grand = {}
    for t in cfg["teams"]:
        si = session_info(t["name"])
        tp = si.get("transcript_path")
        if not tp:
            print(f"{t['name']}: no session recorded"); continue
        rows = {}
        for sid in si.get("sessions", []):
            base = Path(tp).parent / f"{sid}.jsonl"
            for label, path in [("lead", base), *[(f"worker:{p.stem}", p) for p in sorted((base.parent / sid / "subagents").glob("agent-*.jsonl"))]]:
                for model, u in usage_of(path).items():
                    kind = "lead" if label == "lead" else "workers"
                    r = rows.setdefault((kind, model), {"in": 0, "out": 0, "cache_read": 0, "cache_write": 0, "msgs": 0, "n": 0})
                    for k in ("in", "out", "cache_read", "cache_write", "msgs"):
                        r[k] += u[k]
                    r["n"] += 1 if kind == "workers" else 0
        print(f"\n{t['name']}")
        for (kind, model), r in sorted(rows.items()):
            cost = ""
            if model in prices:
                p = prices[model]
                usd = (r["in"] * p.get("in", 0) + r["out"] * p.get("out", 0) + r["cache_read"] * p.get("cache_read", 0) + r["cache_write"] * p.get("cache_write", 0)) / 1e6
                cost = f"  ≈ ${usd:.2f}"
                g = grand.setdefault(t["name"], 0); grand[t["name"]] = g + usd
            extra = f" ({r['n']} agents)" if kind == "workers" else ""
            print(f"  {kind:8}{extra:14} {model:18} out {r['out']:>8,}  in {r['in']:>7,}  cache r/w {r['cache_read']:>10,}/{r['cache_write']:>9,}  msgs {r['msgs']:>4}{cost}")
    if grand:
        print("\ntotal ≈ $" + f"{sum(grand.values()):.2f}  (" + ", ".join(f"{k} ${v:.2f}" for k, v in grand.items()) + ")")
    elif not prices:
        print("\n(no `prices_per_mtok` in teams.json → tokens only)")


def cmd_msg(cfg: dict, a):
    st = load_state()
    h = st.get("handles", {}).get(a.team)
    if not h:
        die(f"no terminal recorded for {a.team} (run `teams up` first)")
    if not driver_for(cfg, st).send(h, " ".join(a.text) + "\n"):
        die(f"could not type into {a.team}'s terminal")


def cmd_down(cfg: dict, a):
    st = load_state()
    drv = driver_for(cfg, st)
    for name, h in st.get("handles", {}).items():
        drv.send(h, "/exit\n")
    stop_board()
    tab = board_tab_state()
    if tab and drv.name != "programa":            # programa: the tab dies with the manager's workspace
        drv.close(tab)
    for name, h in st.get("handles", {}).items():
        drv.close(h)
        print(f"[{name}] closed {drv.describe(h)}")
    BOARD_WS.unlink(missing_ok=True)
    with open(cfg["shared_abs"] / "LOG.md", "a") as fh:
        fh.write(f"## down {datetime.now():%Y-%m-%d %H:%M}\n")
    STATE.unlink(missing_ok=True)


def cmd_cmd(cfg: dict, a):
    t = next((t for t in cfg["teams"] if t["name"] == a.team), None) or die(f"unknown team {a.team}")
    print(shell_line(claude_cmd(cfg, t)))


def cmd_add(cfg_path: Path, a):
    raw = json.loads(cfg_path.read_text())
    if any(t["name"] == a.name for t in raw["teams"]):
        die(f"team {a.name} already exists")
    prompt = cfg_path.parent / "prompts" / f"{a.name}.md"
    if not prompt.exists():
        prompt.parent.mkdir(exist_ok=True)
        tpl = resource({"_root": cfg_path.parent}, "prompts/_template.md").read_text().replace("<TEAM NAME>", a.name.upper())
        prompt.write_text(tpl)
    cwd = Path(a.cwd).resolve()
    if not cwd.is_dir():
        die(f"not a directory: {cwd}")
    raw["teams"].append({"name": a.name, "cwd": os.path.relpath(cwd, cfg_path.parent), "prompt": f"{a.name}.md", "purpose": a.purpose or ""})
    cfg_path.write_text(json.dumps(raw, indent=2, ensure_ascii=False) + "\n")
    print(f"added {a.name} → edit {prompt}")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "_hook":
        return cmd_hook()
    p = argparse.ArgumentParser(prog="teams", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--config", type=Path, default=None, help="instance teams.json (default: $TEAMS_CONFIG or walk up from cwd)")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("up"); s.add_argument("--dry-run", action="store_true"); s.add_argument("--resume", action="store_true")
    sub.add_parser("status")
    sub.add_parser("cost")
    s = sub.add_parser("learn"); s.add_argument("team", nargs="?", default="all"); s.add_argument("--model", default="claude-sonnet-5"); s.add_argument("--force", action="store_true"); s.add_argument("--dry-run", action="store_true")
    s = sub.add_parser("init"); s.add_argument("repo", nargs="*"); s.add_argument("--dir", default=".teams", help="instance directory to create (default: ./.teams)")
    s.add_argument("--force", action="store_true"); s.add_argument("--language", default="English")
    s = sub.add_parser("msg"); s.add_argument("team"); s.add_argument("text", nargs="+")
    s = sub.add_parser("task"); tsub = s.add_subparsers(dest="tcmd", required=True)
    x = tsub.add_parser("new"); x.add_argument("title", nargs="+"); x.add_argument("--team"); x.add_argument("--status", default="backlog", choices=tasklib.STATUSES); x.add_argument("--ref", help="external reference (Jira key, issue number…)"); x.add_argument("--desc"); x.add_argument("--criteria")
    for key in ('scope', 'verify', 'decisions', 'depends'):
        x.add_argument('--' + key)
    x = tsub.add_parser("set"); x.add_argument("id"); x.add_argument("pairs", nargs="+", metavar="key=value")
    x = tsub.add_parser("log"); x.add_argument("id"); x.add_argument("text", nargs="+")
    x = tsub.add_parser("list"); x.add_argument("--status", choices=tasklib.STATUSES)
    x = tsub.add_parser("show"); x.add_argument("id")
    s = sub.add_parser("board"); s.add_argument("--port", type=int)
    sub.add_parser("down")
    s = sub.add_parser("cmd"); s.add_argument("team")
    s = sub.add_parser("add"); s.add_argument("name"); s.add_argument("--cwd", required=True, help="the team's directory (relative to your shell)"); s.add_argument("--purpose")
    a = p.parse_args()
    if a.cmd == "init":
        return cmd_init(a)
    if a.config is None:
        a.config = find_config()
    pinned = a.config.resolve().parent / "engine" / "bin" / "teams"
    if pinned.is_file() and pinned.resolve() != SELF:        # instance vendors its own engine: hand over
        rest = [x for i, x in enumerate(sys.argv[1:]) if x != "--config" and (i == 0 or sys.argv[i] != "--config")]
        os.execv(sys.executable, [sys.executable, str(pinned), "--config", str(a.config), *rest])
    if a.cmd == "add":
        return cmd_add(a.config, a)
    cfg = load(a.config)
    {"up": cmd_up, "status": cmd_status, "cost": cmd_cost, "learn": cmd_learn, "msg": cmd_msg, "down": cmd_down,
     "cmd": cmd_cmd, "task": cmd_task, "board": cmd_board}[a.cmd](cfg, a)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError) as exc:
        die(str(exc))
