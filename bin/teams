#!/usr/bin/env python3
"""teams — launch/manage a set of Claude Code team sessions inside programa.

  teams up [--dry-run] [--resume]       one named programa workspace per team, claude started in each, primary selected
                                        --resume: re-attach to a running setup, restart dead sessions with --continue
  teams status                          liveness per team, PLAN.md task summary, tail of shared/LOG.md
  teams cost                            token usage per team (lead vs workers, per model); $ if prices_per_mtok is set
  teams learn [team|all] [--force]      MANUAL: scan a team's repo once, one cheap LLM call → rules/<team>.md digest (cached by fingerprint)
  teams init <repo>... [--out f]        MANUAL: scan one or more repos, propose a teams.json (one team per detected app; gestion in their common parent)
  teams msg <team> <text...>            type text into a team's terminal (fallback channel)
  teams down                            /exit every team and close their workspaces
  teams add <name> --cwd <dir> [--purpose "..."]   register a new team + prompt stub
  teams cmd <team>                      print the exact `claude` command for a team

Config: teams.json next to ../ (see --config). Prompts in prompts/, workers in agents/.
"""
import argparse, json, os, re, shlex, subprocess, sys, time
from datetime import datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent          # teams/
DEFAULT_CONFIG = HERE / "teams.json"
STATE = HERE / ".state" / "surfaces.json"
SESS = HERE / ".state" / "sessions"          # one json per team, written by the hooks
SELF = Path(__file__).resolve()
RULES = HERE / "rules"

SCAN_FILES = ["CLAUDE.md", ".claude/CLAUDE.md", "AGENTS.md", "README.md", "readme.md", "CONTRIBUTING.md",
              "package.json", "pyproject.toml", "composer.json", "go.mod", "Cargo.toml", "Gemfile", "requirements.txt",
              "tsconfig.json", "tailwind.config.js", "tailwind.config.ts", "tailwind.config.cjs", "postcss.config.js",
              "vite.config.ts", "vite.config.js", "next.config.js", "next.config.ts", "next.config.mjs", "nuxt.config.ts",
              "eslint.config.js", "eslint.config.mjs", ".eslintrc", ".eslintrc.json", ".eslintrc.cjs", ".prettierrc", ".prettierrc.json",
              ".editorconfig", "ruff.toml", "setup.cfg", "pytest.ini", "Makefile", "docker-compose.yml", "Dockerfile", ".env.example"]
SCAN_SKIP = {"node_modules", ".git", "dist", "build", ".next", ".nuxt", ".venv", "venv", "__pycache__", "vendor", "coverage", ".turbo", ".cache", "target"}
LEARN_PROMPT = """You are extracting the coding rules of ONE repository for AI coding agents that will edit it.
Below is a snapshot: key files and dependency list. Produce a digest in EXACTLY this format, in English, max 60 lines total, bullets only, no prose, no headings other than these:

STACK: one line (language, framework, styling/animation/state libs, db, package manager)
COMMANDS:
- run: <cmd> | test: <cmd> | lint: <cmd> | build: <cmd> | format: <cmd>   (only those that exist; say "unknown" if not found)
STRUCTURE: (max 6 lines, only if the docs describe it) where routes/pages, components, models, tests live — path: role; else one line "unknown"
CONVENTIONS: (max 15 lines) only rules that change how code is written: naming, styling approach (e.g. utility classes vs css modules, fluid type helpers), animation lib, state management, data fetching pattern, error handling, typing strictness, i18n, commit/PR conventions if stated
NEVER: (max 5 lines) explicit prohibitions found in docs/config (e.g. no inline styles, no default exports, no raw fetch)
SEE: (max 3 lines) files worth reading before coding, e.g. "CLAUDE.md §Styling", "docs/adr/…" — point, do not copy

Rules: prefer what CLAUDE.md/README/AGENTS.md state over what you infer. If CLAUDE.md exists, do NOT repeat its content — reference it in SEE and only add what it lacks. No speculation: if unknown, write "unknown". Output the digest and nothing else."""


# ---------- config -----------------------------------------------------------
def load(cfg_path: Path) -> dict:
    cfg = json.loads(cfg_path.read_text())
    cfg["_root"] = cfg_path.parent
    cfg["shared_abs"] = (cfg["_root"] / cfg.get("shared_dir", "shared")).resolve()
    cfg["teams"] = [t for t in cfg["teams"] if t.get("enabled", True)]
    runners = cfg.setdefault("runners", {"claude": {"command": "claude"}})
    seen = set()
    for t in cfg["teams"]:
        t["runner_name"] = t.get("runner", cfg["defaults"].get("runner", "claude"))
        if t["runner_name"] not in runners:
            die(f"unknown runner {t['runner_name']!r} for team {t['name']} (define it under \"runners\")")
        t["runner"] = runners[t["runner_name"]]
        if not re.fullmatch(r"[a-z0-9-]+", t["name"]):
            die(f"team name must be [a-z0-9-]: {t['name']}")
        if t["name"] in seen:
            die(f"duplicate team: {t['name']}")
        seen.add(t["name"])
        t["cwd_abs"] = (cfg["_root"] / t["cwd"]).resolve()
        if not t["cwd_abs"].is_dir():
            die(f"cwd not found for {t['name']}: {t['cwd_abs']}")
        t["prompt_abs"] = cfg["_root"] / "prompts" / t.get("prompt", f"{t['name']}.md")
        if not t["prompt_abs"].is_file():
            die(f"prompt not found for {t['name']}: {t['prompt_abs']}")
    primaries = [t for t in cfg["teams"] if t.get("primary")]
    if len(primaries) != 1:
        die("exactly one team must have \"primary\": true")
    return cfg


def die(msg: str, code: int = 1):
    print(f"teams: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------- prompt / agents assembly -----------------------------------------
def parse_agent_md(path: Path) -> tuple[str, dict]:
    text = path.read_text()
    m = re.match(r"^---\n(.*?)\n---\n(.*)$", text, re.S)
    if not m:
        die(f"agent file missing frontmatter: {path}")
    meta = {}
    for line in m.group(1).splitlines():
        k, _, v = line.partition(":")
        meta[k.strip()] = v.strip()
    return meta.pop("name", path.stem), {**meta, "prompt": m.group(2).strip()}


def resolve_workers(cfg: dict, team: dict) -> dict:
    """Merge defaults.workers with team.workers. Entry: dict | model-string | False (remove)."""
    def norm(v):
        return {"model": v} if isinstance(v, str) else v
    base = {} if team.get("workers_replace") else {k: dict(norm(v)) for k, v in cfg["defaults"].get("workers", {}).items() if v is not False}
    for k, v in (team.get("workers") or {}).items():
        if v is False:
            base.pop(k, None)
            continue
        merged = {**base.get(k, {}), **norm(v)}
        merged["vars"] = {**base.get(k, {}).get("vars", {}), **norm(v).get("vars", {})}
        base[k] = merged
    return base


def render(text: str, vars: dict) -> str:
    for k, v in vars.items():
        text = text.replace("{{" + k + "}}", str(v))
    missing = re.findall(r"{{(\w+)}}", text)
    if missing:
        die(f"unset template vars {sorted(set(missing))} — set them under workers.<name>.vars in teams.json")
    return text


def worker_specs(cfg: dict, team: dict) -> dict:
    """name -> full agent spec (description, prompt, model, ...) ready for --agents."""
    specs = {}
    for name, w in resolve_workers(cfg, team).items():
        f = cfg["_root"] / w.get("file", f"agents/{name}.md")
        if not f.is_file():
            die(f"worker {name} for team {team['name']}: file not found {f}")
        _, spec = parse_agent_md(f)
        for k in ("model", "description"):
            if w.get(k):
                spec[k] = w[k]
        rules = "\n".join(x for x in [rules_sections(team["name"]), rules_local(team["name"])] if x)
        vars = {"team": team["name"], "cwd": str(team["cwd_abs"]), "shared_dir": str(cfg["shared_abs"]),
                "rules": ("REPO RULES (follow strictly; CLAUDE.md wins on conflict):\n" + rules) if rules else "", **w.get("vars", {})}
        spec["prompt"] = render(spec["prompt"], vars)
        spec["description"] = render(spec.get("description", ""), vars)
        specs[name] = spec
    if not specs:
        die(f"team {team['name']} has no workers")
    return specs


def build_agents_json(cfg: dict, team: dict) -> str:
    return json.dumps(worker_specs(cfg, team), ensure_ascii=False)


def workers_text(cfg: dict, team: dict) -> str:
    lines = ["# WORKERS available to you (Agent tool, subagent_type = name)"]
    brain = team["runner"].get("brain")
    if brain:
        lines.append(f"(this team runs on {brain}: every worker below actually thinks with that model, whatever its nominal model)")
    for name, spec in worker_specs(cfg, team).items():
        lines.append(f"- `{name}` ({spec.get('model','?')}): {spec.get('description','')}")
    return "\n".join(lines)


def roster_text(cfg: dict, me: dict, surfaces: dict) -> str:
    lines = [f"# ROSTER  (you are: {me['name']})", f"SHARED_DIR: {cfg['shared_abs']}", ""]
    for t in cfg["teams"]:
        tag = " ← you" if t is me else ""
        s = surfaces.get(t["name"], "?")
        brain = t["runner"].get("brain") or t.get("model", cfg["defaults"].get("model", "claude-fable-5"))
        stack = rules_stack(t["name"])
        lines.append(f"- {t['name']}{' (primary)' if t.get('primary') else ''} [{brain}]: {t.get('purpose','')}  cwd={t['cwd_abs']}  surface={s}{tag}"
                     + (f"\n    stack: {stack}" if stack else ""))
    return "\n".join(lines)


def system_prompt(cfg: dict, team: dict, surfaces: dict) -> str:
    rules = "\n\n".join(x for x in [
        ("# REPO RULES (digest generated by `teams learn`; CLAUDE.md in the repo wins on any conflict)\n" + rules_digest(team["name"])) if rules_digest(team["name"]) else "",
        ("# LOCAL RULES (hand-written, authoritative)\n" + rules_local(team["name"])) if rules_local(team["name"]) else "",
    ] if x)
    parts = [
        (cfg["_root"] / "prompts" / "_common.md").read_text(),
        workers_text(cfg, team),
        team["prompt_abs"].read_text(),
        rules,
        roster_text(cfg, team, surfaces),
        (cfg["_root"] / "prompts" / "PROTOCOL.md").read_text(),
    ]
    return "\n\n".join(p.strip() for p in parts)


def claude_cmd(cfg: dict, team: dict, surfaces: dict) -> list[str]:
    prompt_file = HERE / ".state" / f"prompt-{team['name']}.md"
    prompt_file.parent.mkdir(exist_ok=True)
    prompt_file.write_text(system_prompt(cfg, team, surfaces))
    agents_file = HERE / ".state" / f"agents-{team['name']}.json"
    agents_file.write_text(build_agents_json(cfg, team))
    runner = team["runner"]
    cmd = [runner.get("command", "claude"), "-n", team["name"],
           "--model", team.get("model", cfg["defaults"].get("model", "claude-fable-5")),
           "--append-system-prompt-file", str(prompt_file),
           "--agents", f"$(cat {shlex.quote(str(agents_file))})",
           "--add-dir", str(cfg["shared_abs"])]
    for d in [*cfg["defaults"].get("add_dirs", []), *team.get("add_dirs", [])]:
        cmd += ["--add-dir", str((cfg["_root"] / d).resolve())]
    cmd += ["--settings", hook_settings_json(team)]
    pm = team.get("permission_mode", cfg.get("permission_mode"))
    if pm == "yolo":
        cmd.append("--dangerously-skip-permissions")
    elif pm:
        cmd += ["--permission-mode", pm]
    for flag in runner.get("drop_flags", []):          # runners that set their own model/effort
        while flag in cmd:
            i = cmd.index(flag); del cmd[i:i + 2]
    return cmd


def hook_settings_json(team: dict) -> str:
    """Claude Code hooks that make each team session report to .state/ — no reliance on prompts."""
    hook = f"TEAMS_TEAM={shlex.quote(team['name'])} TEAMS_ROOT={shlex.quote(str(HERE))} python3 {shlex.quote(str(SELF))} _hook"
    ev = lambda: [{"matcher": "", "hooks": [{"type": "command", "command": hook, "timeout": 5}]}]
    return json.dumps({"hooks": {
        "SessionStart": ev(), "UserPromptSubmit": ev(), "Stop": ev(), "SessionEnd": ev(),
        "PreToolUse": [{"matcher": "SendMessage", "hooks": [{"type": "command", "command": hook, "timeout": 5}]}],
    }})


def cmd_hook():
    """Entry point for the injected hooks (stdin = hook JSON). Never fails the tool call."""
    team, root = os.environ.get("TEAMS_TEAM", "?"), Path(os.environ.get("TEAMS_ROOT", str(HERE)))
    try:
        d = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        d = {}
    ev = d.get("hook_event_name", "")
    sess_dir = root / ".state" / "sessions"; sess_dir.mkdir(parents=True, exist_ok=True)
    f = sess_dir / f"{team}.json"
    try:
        st = json.loads(f.read_text()) if f.exists() else {}
    except json.JSONDecodeError:
        st = {}
    st.update({k: d[k] for k in ("session_id", "transcript_path", "cwd") if d.get(k)})
    st["status"] = {"SessionStart": "idle", "UserPromptSubmit": "working", "Stop": "idle", "SessionEnd": "gone"}.get(ev, st.get("status", "?"))
    st["updated"] = datetime.now().isoformat(timespec="seconds")
    st.setdefault("sessions", [])
    if d.get("session_id") and d["session_id"] not in st["sessions"]:
        st["sessions"].append(d["session_id"])
    if ev == "SessionEnd":
        st.pop("session_id", None)
    f.write_text(json.dumps(st, indent=2))
    if ev == "PreToolUse" and d.get("tool_name") == "SendMessage":
        ti = d.get("tool_input", {})
        msg = ti.get("message"); msg = msg if isinstance(msg, str) else json.dumps(msg)
        head, _, body = msg.partition("\n")
        cfg_shared = None
        try:
            cfg = json.loads((root / "teams.json").read_text())
            cfg_shared = (root / cfg.get("shared_dir", "shared")).resolve()
        except Exception:
            cfg_shared = root / "shared"
        line = f"{datetime.now():%H:%M:%S} {team} → {ti.get('to','?')} | {head.strip()}"
        if body.strip():
            line += f"\n    " + "\n    ".join(l for l in body.strip().splitlines()[:5])
        with open(cfg_shared / "LOG.md", "a") as fh:
            fh.write(line + "\n")
    print("{}")


def pretrust(cfg: dict):
    """Mark every team cwd as trusted in ~/.claude.json so no 'trust this folder' dialog blocks a pane."""
    path = Path.home() / ".claude.json"
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return
    projects = data.setdefault("projects", {})
    changed = False
    for t in cfg["teams"]:
        entry = projects.setdefault(str(t["cwd_abs"]), {})
        if not entry.get("hasTrustDialogAccepted"):
            entry["hasTrustDialogAccepted"] = True
            changed = True
    if changed:
        path.write_text(json.dumps(data, indent=2, ensure_ascii=False))


def shell_line(cmd: list[str]) -> str:
    # keep the $(cat ...) unquoted so the shell expands it
    return " ".join(f'"{c}"' if c.startswith("$(") else shlex.quote(c) for c in cmd)


# ---------- rules (manual: teams learn / teams init) -------------------------
def _read_cap(p: Path, cap: int = 6000) -> str:
    try:
        t = p.read_text(errors="replace")
    except OSError:
        return ""
    return t if len(t) <= cap else t[:cap] + f"\n… [truncated {len(t)-cap} chars]"


def scan_repo(root: Path) -> dict:
    files = {}
    for rel in SCAN_FILES:
        p = root / rel
        if p.is_file():
            files[rel] = _read_cap(p)
    deps = []
    pj = root / "package.json"
    if pj.is_file():
        try:
            j = json.loads(pj.read_text())
            deps += sorted({**j.get("dependencies", {}), **j.get("devDependencies", {})})
        except json.JSONDecodeError:
            pass
    py = root / "pyproject.toml"
    if py.is_file():
        txt = py.read_text(errors="replace")
        for block in re.findall(r'dependencies\s*=\s*\[(.*?)\]', txt, re.S):
            deps += [m.lower() for m in re.findall(r'["\']([A-Za-z0-9_.-]+)', block)]
        deps += [m.lower() for m in re.findall(r'^([A-Za-z0-9_.-]+)\s*=\s*[\'"^~>=<{]', txt, re.M) if m not in ("name", "version", "description", "readme", "python")]
    return {"files": files, "deps": deps}


def fingerprint(root: Path) -> str:
    import hashlib
    h = hashlib.sha256()
    for rel in SCAN_FILES:
        p = root / rel
        if p.is_file():
            h.update(rel.encode()); h.update(p.read_bytes())
    return h.hexdigest()[:16]


def rules_paths(name: str) -> tuple[Path, Path]:
    return RULES / f"{name}.md", RULES / f"{name}.local.md"


def rules_fingerprint(name: str) -> str | None:
    f, _ = rules_paths(name)
    if not f.is_file():
        return None
    m = re.search(r"fingerprint: ([0-9a-f]+)", f.read_text())
    return m.group(1) if m else None


def rules_digest(name: str) -> str:
    """Generated digest without the header comment (empty if none)."""
    f, _ = rules_paths(name)
    if not f.is_file():
        return ""
    return re.sub(r"^<!--.*?-->\s*", "", f.read_text(), flags=re.S).strip()


def rules_local(name: str) -> str:
    _, l = rules_paths(name)
    return l.read_text().strip() if l.is_file() else ""


def rules_sections(name: str, wanted=("COMMANDS", "CONVENTIONS", "NEVER")) -> str:
    """Subset of the digest for workers (they write code; they don't need STRUCTURE/SEE)."""
    out, keep = [], False
    for line in rules_digest(name).splitlines():
        m = re.match(r"^([A-Z]+):", line)
        if m:
            keep = m.group(1) in wanted
        if keep:
            out.append(line)
    return "\n".join(out)


def rules_stack(name: str) -> str:
    m = re.search(r"^STACK:\s*(.+)$", rules_digest(name), re.M)
    return m.group(1).strip() if m else ""


def cmd_learn(cfg: dict, a):
    targets = [t for t in cfg["teams"] if not t.get("primary")] if a.team == "all" else [t for t in cfg["teams"] if t["name"] == a.team]
    if not targets:
        die(f"unknown team {a.team}")
    RULES.mkdir(exist_ok=True)
    for t in targets:
        root = t["cwd_abs"]
        fp = fingerprint(root)
        f, _ = rules_paths(t["name"])
        if f.is_file() and rules_fingerprint(t["name"]) == fp and not a.force:
            print(f"[{t['name']}] rules up to date ({fp}) — use --force to regenerate"); continue
        snap = scan_repo(root)
        if not snap["files"] and not snap["deps"]:
            print(f"[{t['name']}] nothing to learn in {root} (no manifest/README/CLAUDE.md)"); continue
        body = [f"REPO: {root}", "", "## DEPENDENCIES", ", ".join(snap["deps"]) or "(none)", ""]
        for rel, txt in snap["files"].items():
            body += [f"## FILE {rel}", txt, ""]
        prompt = LEARN_PROMPT + "\n\n" + "\n".join(body)
        if a.dry_run:
            print(f"[{t['name']}] would send ~{len(prompt)//4:,} tokens to {a.model} ({len(snap['files'])} files, {len(snap['deps'])} deps)"); continue
        print(f"[{t['name']}] learning from {root} (~{len(prompt)//4:,} tokens → {a.model}) …")
        r = subprocess.run(["claude", "-p", "--model", a.model, "--tools", "", "--no-session-persistence", "--output-format", "text"],
                           input=prompt, capture_output=True, text=True, cwd=str(root))
        if r.returncode != 0 or not r.stdout.strip():
            print(f"[{t['name']}] FAILED: {r.stderr.strip()[:300]}"); continue
        digest = "\n".join(r.stdout.strip().splitlines()[:70])
        f.write_text(f"<!-- generated by `teams learn` — fingerprint: {fp} — {datetime.now():%Y-%m-%d %H:%M} — model: {a.model} — do not edit; put your own rules in {t['name']}.local.md -->\n{digest}\n")
        print(f"[{t['name']}] wrote {f.relative_to(HERE)} ({len(digest.splitlines())} lines)")


def check_rules_fresh(cfg: dict):
    for t in cfg["teams"]:
        if t.get("primary"):
            continue
        have = rules_fingerprint(t["name"])
        if have is None:
            print(f"[{t['name']}] no rules digest — `teams learn {t['name']}` (manual, optional)")
        elif have != fingerprint(t["cwd_abs"]):
            print(f"[{t['name']}] rules digest is STALE (repo config changed) — `teams learn {t['name']} --force`")


def cmd_init(a):
    """Scan a repo and propose a teams.json (manual; never overwrites without --force)."""
    roots = [Path(r).resolve() for r in a.repo]
    for r in roots:
        if not r.is_dir():
            die(f"not a directory: {r}")
    root = Path(os.path.commonpath([str(r) for r in roots])) if len(roots) > 1 else roots[0]   # gestion's cwd
    out = Path(a.out).resolve() if a.out else HERE / "teams.json"
    if out.exists() and not a.force:
        die(f"{out} exists — use --force to overwrite, or --out <file>")
    FRONT = {"react", "vue", "svelte", "next", "nuxt", "@angular/core", "solid-js", "astro", "vite"}
    BACK = {"fastapi", "django", "flask", "express", "@nestjs/core", "hono", "koa", "fastify", "laravel/framework", "rails", "gin"}
    apps, seen_dirs = [], set()
    manifests = []
    for r in roots:
        for pat in ("package.json", "*/package.json", "*/*/package.json", "pyproject.toml", "*/pyproject.toml", "*/*/pyproject.toml",
                    "composer.json", "*/composer.json"):
            manifests += list(r.glob(pat))
    for pj in manifests:
        if any(part in SCAN_SKIP for part in pj.parts) or pj.parent in seen_dirs:
            continue
        seen_dirs.add(pj.parent)
        d = pj.parent
        deps = set(scan_repo(d)["deps"])
        kind = "frontend" if deps & FRONT else "backend" if deps & BACK else None
        if kind:
            apps.append((kind, d))
    if not apps:
        die(f"no app detected under {', '.join(map(str, roots))}")
    teams, seen = [{"name": "gestion", "title": "Gestion", "primary": True, "cwd": os.path.relpath(root, out.parent), "prompt": "gestion.md",
                    "purpose": "Planifie avec l'utilisateur, dispatche, contrôle. Ne code pas.", "add_dirs": []}], {}
    for kind, d in apps:
        n = kind if kind not in seen else f"{kind}-{d.name}"
        seen[kind] = seen.get(kind, 0) + 1
        rel = os.path.relpath(d, out.parent)
        teams.append({"name": n, "title": n.capitalize(), "cwd": rel, "prompt": f"{kind}.md", "purpose": f"{kind} ({d.name})"})
        teams[0]["add_dirs"].append(rel)
    cfg = {"$doc": ["generated by `teams init` — review cwd/titles/workers, then `teams learn all`"],
           "shared_dir": "shared", "permission_mode": "yolo", "shell_prompt_regex": "(➜|→|❯|\\$|%|#) ",
           "runners": {"claude": {"command": "claude"}},
           "defaults": {"model": "claude-fable-5", "runner": "claude", "add_dirs": [],
                        "workers": {"worker-simple": {"model": "claude-sonnet-5"}, "worker-complex": {"model": "claude-opus-5"}}},
           "teams": teams}
    out.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")
    print(f"wrote {out}\n" + "\n".join(f"  {t['name']:12} {t['cwd']}" for t in teams) + "\nnext: review it, then `teams learn all`")


# ---------- programa ---------------------------------------------------------
def in_programa() -> bool:
    return bool(os.environ.get("PROGRAMA_SURFACE_ID") and os.environ.get("PROGRAMA_SOCKET_PATH"))


def programa(*args: str, check=True) -> str:
    r = subprocess.run(["programa", *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        die(f"programa {' '.join(args)} failed: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout.strip()


def load_state() -> dict:
    return json.loads(STATE.read_text()) if STATE.exists() else {}


def save_state(d: dict):
    STATE.parent.mkdir(exist_ok=True)
    STATE.write_text(json.dumps(d, indent=2))


def write_roster_json(cfg: dict, surfaces: dict):
    data = {"shared_dir": str(cfg["shared_abs"]),
            "teams": {t["name"]: {"cwd": str(t["cwd_abs"]), "surface": surfaces.get(t["name"]),
                                   "primary": bool(t.get("primary")), "purpose": t.get("purpose", "")}
                      for t in cfg["teams"]}}
    (cfg["shared_abs"] / ".roster.json").write_text(json.dumps(data, indent=2))


def preflight_runners(cfg: dict):
    """For every runner in use with a healthcheck URL: ensure it answers, else run its start command and wait."""
    import time, urllib.request, urllib.error
    def alive(url):
        try:
            urllib.request.urlopen(url, timeout=2); return True
        except urllib.error.HTTPError:
            return True                       # 401/404 = something answers
        except Exception:
            return False
    for name in {t["runner_name"] for t in cfg["teams"]}:
        r = cfg["runners"][name]
        url = r.get("healthcheck")
        if not url or alive(url):
            continue
        if not r.get("start"):
            die(f"runner {name}: {url} does not answer and no `start` command is configured")
        print(f"[{name}] {url} down → {r['start']}")
        subprocess.run(r["start"], shell=True, check=False)
        for _ in range(15):
            time.sleep(1)
            if alive(url):
                break
        else:
            die(f"runner {name}: still no answer at {url} after start")


# ---------- commands ---------------------------------------------------------
def wait_shell(ws: str, surf: str, cfg: dict):
    """Block until the shell prompt is visible in a fresh workspace, so a typed command is not lost."""
    pat = cfg.get("shell_prompt_regex", r"(➜|→|❯|\$|%|#) ")
    r = subprocess.run(["programa", "wait-surface", "--workspace", ws, "--surface", surf, "--pattern", pat, "--timeout", "15"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        time.sleep(3)                                     # fallback: give the shell a moment anyway
    time.sleep(0.3)


def workspace_surface(ws_ref: str) -> str:
    """First terminal surface of a workspace (the shell new-workspace opened)."""
    data = json.loads(programa("--json", "tree", "--workspace", ws_ref))
    for w in data.get("windows", []):
        for ws in w.get("workspaces", []):
            if ws.get("ref") == ws_ref:
                for pane in ws.get("panes", []):
                    for surf in pane.get("surfaces", []):
                        if surf.get("type") == "terminal":
                            return surf["ref"]
    die(f"no terminal surface found in {ws_ref}")


def cmd_up(cfg: dict, a):
    pretrust(cfg)
    check_rules_fresh(cfg)
    if not a.dry_run:
        preflight_runners(cfg)
    primary = next(t for t in cfg["teams"] if t.get("primary"))
    ordered = [t for t in cfg["teams"] if not t.get("primary")] + [primary]   # primary last -> ends up selected
    surfaces, workspaces = {}, {}
    if a.dry_run or not in_programa():
        if not a.dry_run:
            print("Not inside programa - printing commands to run manually (one per terminal):\n")
        for t in ordered:
            print(f"# {t['name']}  (cd {t['cwd_abs']})")
            print(shell_line(claude_cmd(cfg, t, surfaces)), "\n")
        write_roster_json(cfg, surfaces)
        return
    if a.resume:
        return cmd_resume(cfg, ordered, primary)
    if load_state():
        die("teams already up (see .state/surfaces.json) - run `teams down` first, or `teams up --resume`")
    (cfg["shared_abs"] / "LOG.md").touch()
    with open(cfg["shared_abs"] / "LOG.md", "a") as fh:
        fh.write(f"\n## up {datetime.now():%Y-%m-%d %H:%M}\n")
    # 1) one named workspace per team, so every roster knows every surface before any claude starts
    for t in ordered:
        args = ["new-workspace", "--name", t.get("title", t["name"]), "--cwd", str(t["cwd_abs"])]
        if t.get("purpose"):
            args += ["--description", t["purpose"]]
        ws = programa(*args).split()[1]                     # "OK workspace:6"
        workspaces[t["name"]] = ws
        surfaces[t["name"]] = workspace_surface(ws)
        print(f"[{t['name']}] workspace {ws} / surface {surfaces[t['name']]}")
    save_state({"surfaces": surfaces, "workspaces": workspaces, "started_at": datetime.now().isoformat(timespec="seconds")})
    write_roster_json(cfg, surfaces)
    for f in SESS.glob("*.json"):
        f.unlink()
    # 2) launch claude in each workspace (after its shell prompt is up)
    for t in ordered:
        wait_shell(workspaces[t["name"]], surfaces[t["name"]], cfg)
        programa("send", "--workspace", workspaces[t["name"]], "--surface", surfaces[t["name"]],
                 shell_line(claude_cmd(cfg, t, surfaces)) + "\n")
    programa("select-workspace", "--workspace", workspaces[primary["name"]], check=False)
    print(f"\n{primary['name']} is selected - talk to it there. `teams down` closes everything.")


def session_info(name: str) -> dict:
    f = SESS / f"{name}.json"
    try:
        return json.loads(f.read_text()) if f.exists() else {}
    except json.JSONDecodeError:
        return {}


_TTY_CACHE = {}
def surface_tty(ws: str, surf: str) -> str | None:
    if not in_programa():
        return None
    if ws not in _TTY_CACHE:
        try:
            data = json.loads(programa("--json", "tree", "--workspace", ws))
        except SystemExit:
            data = {}
        m = {}
        for w in data.get("windows", []):
            for x in w.get("workspaces", []):
                for pane in x.get("panes", []):
                    for sf in pane.get("surfaces", []):
                        m[sf["ref"]] = sf.get("tty")
        _TTY_CACHE[ws] = m
    return _TTY_CACHE[ws].get(surf)


def process_alive(name: str) -> bool:
    """Alive = a claude process runs on the team's pane tty (robust to programa rewriting argv / --continue)."""
    st = load_state()
    tty = surface_tty(st.get("workspaces", {}).get(name, ""), st.get("surfaces", {}).get(name, ""))
    if tty:
        r = subprocess.run(["ps", "-t", tty, "-o", "command="], capture_output=True, text=True)
        return any("/claude" in l or l.startswith("claude") for l in r.stdout.splitlines())
    sid = session_info(name).get("session_id")
    if sid:
        return subprocess.run(["pgrep", "-f", f"claude.*--session-id {sid}"], capture_output=True).returncode == 0
    return False


def workspace_exists(ws: str) -> bool:
    try:
        return ws in programa("--json", "list-workspaces") if in_programa() else False
    except SystemExit:
        return False


def plan_summary(cfg: dict) -> str:
    f = cfg["shared_abs"] / "PLAN.md"
    if not f.exists():
        return "PLAN.md: none"
    rows = [l for l in f.read_text().splitlines() if l.startswith("|") and not set(l) <= set("|- ")]
    tasks = [[c.strip() for c in l.strip("|").split("|")] for l in rows[1:]] if rows else []
    tasks = [t for t in tasks if t and re.fullmatch(r"T\d+", t[0])]
    if not tasks:
        return "PLAN.md: no tasks yet"
    by = {}
    for t in tasks:
        st = t[4] if len(t) > 4 else "?"
        by[st] = by.get(st, 0) + 1
    title = next((l[2:] for l in f.read_text().splitlines() if l.startswith("# ")), "")
    return f"PLAN.md: {title} — " + ", ".join(f"{v} {k}" for k, v in by.items()) + "\n  " + "\n  ".join(
        f"{t[0]} [{t[1]}] {t[4] if len(t)>4 else '?':6} {t[2][:60]}" for t in tasks)


def cmd_status(cfg: dict, a):
    st = load_state()
    if not st:
        print("teams: down (no state). `teams up` to start."); return
    print(f"up since {st.get('started_at','?')}\n")
    for t in cfg["teams"]:
        si = session_info(t["name"])
        alive = process_alive(t["name"])
        state = si.get("status", "?") if alive else "DEAD"
        ws = st.get("workspaces", {}).get(t["name"], "?")
        print(f"  {t['name']:10} {state:8} {ws:14} last {si.get('updated','-')[11:]:8} session {str(si.get('session_id','-'))[:8]}")
    print("\n" + plan_summary(cfg))
    log = cfg["shared_abs"] / "LOG.md"
    if log.exists():
        lines = [l for l in log.read_text().splitlines() if l.strip()]
        print("\nLOG.md (last 12):\n  " + "\n  ".join(lines[-12:]))


def cmd_resume(cfg: dict, ordered: list, primary: dict):
    """Re-attach to an existing `up`: recreate missing workspaces, restart dead sessions with --continue."""
    st = load_state()
    if not st:
        die("nothing to resume (no state) — run `teams up`")
    surfaces, workspaces = st.get("surfaces", {}), st.get("workspaces", {})
    for t in ordered:
        n = t["name"]
        if not workspaces.get(n) or not workspace_exists(workspaces[n]):
            args = ["new-workspace", "--name", t.get("title", n), "--cwd", str(t["cwd_abs"])]
            ws = programa(*args).split()[1]
            workspaces[n], surfaces[n] = ws, workspace_surface(ws)
            print(f"[{n}] workspace recreated {ws}")
    save_state({**st, "surfaces": surfaces, "workspaces": workspaces})
    write_roster_json(cfg, surfaces)
    for t in ordered:
        n = t["name"]
        if process_alive(n):
            print(f"[{n}] alive — untouched")
            continue
        cmd = claude_cmd(cfg, t, surfaces)
        cmd.insert(1, "--continue")                      # resume that dir's latest conversation
        wait_shell(workspaces[n], surfaces[n], cfg)
        programa("send", "--workspace", workspaces[n], "--surface", surfaces[n], shell_line(cmd) + "\n")
        print(f"[{n}] restarted with --continue")
    with open(cfg["shared_abs"] / "LOG.md", "a") as fh:
        fh.write(f"\n## resume {datetime.now():%Y-%m-%d %H:%M}\n")
    programa("select-workspace", "--workspace", workspaces[primary["name"]], check=False)


def usage_of(path: Path) -> dict:
    """Aggregate token usage of one transcript by model, deduping streamed chunks by message id."""
    seen, out = {}, {}
    try:
        for line in open(path):
            try:
                d = json.loads(line)
            except json.JSONDecodeError:
                continue
            m = d.get("message") or {}
            if d.get("type") != "assistant" or "usage" not in m:
                continue
            seen[m.get("id") or d.get("uuid")] = (m.get("model", "?"), m["usage"])
    except OSError:
        return out
    for model, u in seen.values():
        o = out.setdefault(model, {"in": 0, "out": 0, "cache_read": 0, "cache_write": 0, "msgs": 0})
        o["in"] += u.get("input_tokens", 0); o["out"] += u.get("output_tokens", 0)
        o["cache_read"] += u.get("cache_read_input_tokens", 0); o["cache_write"] += u.get("cache_creation_input_tokens", 0)
        o["msgs"] += 1
    return out


def cmd_cost(cfg: dict, a):
    prices = cfg.get("prices_per_mtok", {})          # {model: {"in":x,"out":y,"cache_read":z,"cache_write":w}}
    grand = {}
    for t in cfg["teams"]:
        si = session_info(t["name"])
        tp = si.get("transcript_path")
        if not tp:
            print(f"{t['name']}: no session recorded"); continue
        rows = {}
        for sid in si.get("sessions", []):
            base = Path(tp).parent / f"{sid}.jsonl"
            for label, path in [("lead", base), *[(f"worker:{p.stem}", p) for p in sorted((base.parent / sid / "subagents").glob("agent-*.jsonl"))]]:
                for model, u in usage_of(path).items():
                    kind = "lead" if label == "lead" else "workers"
                    r = rows.setdefault((kind, model), {"in": 0, "out": 0, "cache_read": 0, "cache_write": 0, "msgs": 0, "n": 0})
                    for k in ("in", "out", "cache_read", "cache_write", "msgs"):
                        r[k] += u[k]
                    r["n"] += 1 if kind == "workers" else 0
        print(f"\n{t['name']}")
        for (kind, model), r in sorted(rows.items()):
            cost = ""
            if model in prices:
                p = prices[model]
                usd = (r["in"] * p.get("in", 0) + r["out"] * p.get("out", 0) + r["cache_read"] * p.get("cache_read", 0) + r["cache_write"] * p.get("cache_write", 0)) / 1e6
                cost = f"  ≈ ${usd:.2f}"
                g = grand.setdefault(t["name"], 0); grand[t["name"]] = g + usd
            extra = f" ({r['n']} agents)" if kind == "workers" else ""
            print(f"  {kind:8}{extra:14} {model:18} out {r['out']:>8,}  in {r['in']:>7,}  cache r/w {r['cache_read']:>10,}/{r['cache_write']:>9,}  msgs {r['msgs']:>4}{cost}")
    if grand:
        print("\ntotal ≈ $" + f"{sum(grand.values()):.2f}  (" + ", ".join(f"{k} ${v:.2f}" for k, v in grand.items()) + ")")
    elif not prices:
        print("\n(no `prices_per_mtok` in teams.json → tokens only)")


def team_target(name: str) -> list[str]:
    st = load_state()
    s, w = st.get("surfaces", {}).get(name), st.get("workspaces", {}).get(name)
    if not s:
        die(f"no surface recorded for {name} (run `teams up` first)")
    return ["--workspace", w, "--surface", s]


def cmd_msg(cfg: dict, a):
    programa("send", *team_target(a.team), " ".join(a.text) + "\n")


def cmd_down(cfg: dict, a):
    st = load_state()
    for name, surf in st.get("surfaces", {}).items():
        programa("send", "--workspace", st["workspaces"][name], "--surface", surf, "/exit\n", check=False)
    for name, ws in st.get("workspaces", {}).items():
        programa("close-workspace", "--workspace", ws, check=False)
        print(f"[{name}] closed {ws}")
    with open(cfg["shared_abs"] / "LOG.md", "a") as fh:
        fh.write(f"## down {datetime.now():%Y-%m-%d %H:%M}\n")
    STATE.unlink(missing_ok=True)


def cmd_cmd(cfg: dict, a):
    t = next((t for t in cfg["teams"] if t["name"] == a.team), None) or die(f"unknown team {a.team}")
    print(shell_line(claude_cmd(cfg, t, load_state().get("surfaces", {}))))


def cmd_add(cfg_path: Path, a):
    raw = json.loads(cfg_path.read_text())
    if any(t["name"] == a.name for t in raw["teams"]):
        die(f"team {a.name} already exists")
    prompt = cfg_path.parent / "prompts" / f"{a.name}.md"
    if not prompt.exists():
        tpl = (cfg_path.parent / "prompts" / "_template.md").read_text().replace("<TEAM NAME>", a.name.upper())
        prompt.write_text(tpl)
    raw["teams"].append({"name": a.name, "cwd": a.cwd, "prompt": f"{a.name}.md", "purpose": a.purpose or ""})
    cfg_path.write_text(json.dumps(raw, indent=2, ensure_ascii=False) + "\n")
    print(f"added {a.name} → edit {prompt}")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "_hook":
        return cmd_hook()
    p = argparse.ArgumentParser(prog="teams", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("up"); s.add_argument("--dry-run", action="store_true"); s.add_argument("--resume", action="store_true")
    sub.add_parser("status")
    sub.add_parser("cost")
    s = sub.add_parser("learn"); s.add_argument("team", nargs="?", default="all"); s.add_argument("--model", default="claude-sonnet-5"); s.add_argument("--force", action="store_true"); s.add_argument("--dry-run", action="store_true")
    s = sub.add_parser("init"); s.add_argument("repo", nargs="+"); s.add_argument("--out"); s.add_argument("--force", action="store_true")
    s = sub.add_parser("msg"); s.add_argument("team"); s.add_argument("text", nargs="+")
    sub.add_parser("down")
    s = sub.add_parser("cmd"); s.add_argument("team")
    s = sub.add_parser("add"); s.add_argument("name"); s.add_argument("--cwd", required=True); s.add_argument("--purpose")
    a = p.parse_args()
    if a.cmd == "add":
        return cmd_add(a.config, a)
    if a.cmd == "init":
        return cmd_init(a)
    cfg = load(a.config)
    {"up": cmd_up, "status": cmd_status, "cost": cmd_cost, "learn": cmd_learn, "msg": cmd_msg, "down": cmd_down, "cmd": cmd_cmd}[a.cmd](cfg, a)


if __name__ == "__main__":
    main()
