#!/usr/bin/env python3
"""teams-board — local kanban web UI bound live to SHARED_DIR/tasks/*.md.

Zero dependency (stdlib only). The files are the source of truth: this server is a view
plus a pen. It watches mtimes (2×/s) and pushes SSE; UI writes go through the same
tasklib the CLI and hooks use. Moving a ticket to `todo` from the UI queues a notification
for the manager, delivered by typing one line into its terminal (see bin/terminal.py).

Started by `teams up` (port picked by the OS, url in <instance>/.state/board.json) or
standalone: `bin/teams-board --root <instance dir>`.
"""
import argparse, json, os, re, signal, subprocess, sys, threading, time, queue
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import tasklib
import storage
import terminal
import uuid

CTX = {}          # root, shared, cfg, url — filled in main()


# ---------- config / state ---------------------------------------------------
def load_ctx(root: Path, config=None):
    cfg = json.loads((config or root / "teams.json").read_text())
    shared = (root / cfg.get("shared_dir", "shared")).resolve()
    primary = next((t["name"] for t in cfg.get("teams", []) if t.get("primary")), None)
    CTX.update(root=root, cfg=cfg, shared=shared, primary=primary,
               board=cfg.get("board", {}), state=root / ".state")


def sessions_state() -> list:
    out = []
    for t in CTX["cfg"].get("teams", []):
        if not t.get("enabled", True):
            continue
        f = CTX["state"] / "sessions" / f"{t['name']}.json"
        si = {}
        try:
            si = json.loads(f.read_text()) if f.exists() else {}
        except (OSError, json.JSONDecodeError):
            pass
        out.append({"name": t["name"], "title": t.get("title", t["name"]), "primary": bool(t.get("primary")),
                    "purpose": t.get("purpose", ""), "status": si.get("status", "gone"), "updated": si.get("updated", "")})
    return out


def plan_title() -> str:
    f = CTX["shared"] / "PLAN.md"
    try:
        for l in f.read_text().splitlines():
            if l.startswith("# "):
                return re.sub(r"^Feature:\s*", "", l[2:]).strip()
    except OSError:
        pass
    return ""


def api_state() -> dict:
    return {"plan_title": plan_title(),
            "ref_base_url": CTX["board"].get("ref_base_url", ""),
            "shared_dir": CTX["cfg"].get("shared_dir", "shared"),
            "teams": sessions_state(),
            "notify_available": notification_available(),
            "pending_notifications": len(storage.read_json(CTX["state"] / "notifications.json", [])),
            "transitions": {key: [s for s in tasklib.STATUSES if s in values]
                            for key, values in tasklib.TRANSITIONS.items()}}


# ---------- wake the manager (primary team) ------------------------------------------------------
def _primary_terminal():
    """(driver, handle) of the manager's terminal as recorded by `teams up`, or (None, None)."""
    st = storage.read_json(CTX['state'] / 'terminal.json')
    h = st.get('handles', {}).get(CTX['primary'])
    if not h or not st.get('driver'):
        return None, None
    try:
        return terminal.driver(st['driver'], CTX['cfg'], CTX['root']), h
    except ValueError:
        return None, None


def _can_wake(drv, handle):
    """A driver that cannot type into its terminals (warp) is not a delivery channel: say so in the
    header instead of failing on every retry. Pending notifications stay queued for the human."""
    return bool(handle and drv and drv.available() and getattr(drv, 'types_commands', True))


def notification_available():
    return _can_wake(*_primary_terminal())


def _send_primary(text):
    drv, h = _primary_terminal()
    if not _can_wake(drv, h):
        return False
    return drv.send(h, text + '\n')


def notify_primary(text):
    path = CTX['state'] / 'notifications.json'
    with storage.locked(path.with_suffix('.lock')):
        pending = storage.read_json(path, [])
        if not any(item['text'] == text for item in pending):
            pending.append({'id': uuid.uuid4().hex, 'text': text, 'at': tasklib.now()})
            storage.write_json(path, pending)


def retry_pending():
    path = CTX['state'] / 'notifications.json'
    # Serialize senders, but release the queue lock during terminal I/O so HTTP stays responsive.
    with storage.locked(CTX['state'] / 'notification-sender.lock'):
        while True:
            with storage.locked(path.with_suffix('.lock')):
                pending = storage.read_json(path, [])
                if not pending:
                    return
                item = pending[0]
            if not _send_primary(item['text']):
                return
            with storage.locked(path.with_suffix('.lock')):
                pending = storage.read_json(path, [])
                storage.write_json(path, [p for p in pending if p['id'] != item['id']])


# ---------- SSE hub + file watcher -------------------------------------------
class Hub:
    def __init__(self):
        self.clients, self.lock = set(), threading.Lock()

    def attach(self):
        q = queue.Queue(maxsize=200)
        with self.lock:
            self.clients.add(q)
        return q

    def detach(self, q):
        with self.lock:
            self.clients.discard(q)

    def send(self, event: str, data):
        msg = (event, json.dumps(data, ensure_ascii=False))
        with self.lock:
            for q in list(self.clients):
                try:
                    q.put_nowait(msg)
                except queue.Full:
                    self.clients.discard(q)


HUB = Hub()


def state_signature():
    paths = [*(CTX['state'] / 'sessions').glob('*.json'),
             CTX['state'] / 'terminal.json', CTX['state'] / 'notifications.json']
    result = []
    for path in paths:
        try:
            result.append((str(path), path.stat().st_mtime_ns))
        except FileNotFoundError:
            pass
    return tuple(sorted(result))


def watcher():
    """Poll mtimes of tasks/ and sessions/ every 500 ms; broadcast diffs as SSE events."""
    seen_tasks, seen_sess = {}, None
    first, tick = True, 0
    while True:
        try:
            tick += 1
            if tick % 10 == 0:
                retry_pending()
            cur = {}
            for p in tasklib.tasks_dir(CTX["shared"]).glob("T*.md"):
                try:
                    cur[p.stem] = p.stat().st_mtime_ns
                except OSError:
                    pass
            if not first:
                for tid in seen_tasks.keys() - cur.keys():
                    HUB.send("task-deleted", {"id": tid})
                for tid, mt in cur.items():
                    if seen_tasks.get(tid) != mt:
                        try:
                            HUB.send("task", tasklib.load(CTX["shared"], tid))
                        except (OSError, ValueError):
                            pass
            seen_tasks = cur

            sig = state_signature()
            if not first and sig != seen_sess:
                HUB.send("state", api_state())
            seen_sess, first = sig, False
        except Exception as e:                                     # the watcher must never die
            print(f"watcher: {e}", file=sys.stderr)
        time.sleep(0.5)


# ---------- HTTP -------------------------------------------------------------
class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "teams-board"

    def log_message(self, fmt, *args):                              # quiet access log
        pass

    # helpers
    def _json(self, code: int, data):
        raw = json.dumps(data, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def _err(self, code: int, msg: str):
        self._json(code, {"error": msg})

    def _body(self) -> dict:
        n = int(self.headers.get("Content-Length") or 0)
        if n > 1_000_000:
            raise ValueError("body too large")
        d = json.loads(self.rfile.read(n) or b"{}")
        if not isinstance(d, dict):
            raise ValueError("expected a JSON object")
        return d

    def _tid(self) -> str | None:
        m = re.fullmatch(r"/api/tasks/(T\d+)(/comment)?", self.path)
        return m.group(1) if m else None

    # routes
    def do_GET(self):
        if self.path in ("/", "/index.html"):
            return self._file(Path(__file__).resolve().parent.parent / "tools" / "board" / "index.html", "text/html; charset=utf-8")
        if self.path == "/api/tasks":
            return self._json(200, tasklib.load_all(CTX["shared"]))
        if self.path == "/api/state":
            return self._json(200, api_state())
        if self.path == "/events":
            return self._sse()
        tid = self._tid()
        if tid:
            try:
                return self._json(200, tasklib.load(CTX["shared"], tid))
            except OSError:
                return self._err(404, f"{tid} not found")
        self._err(404, "not found")

    def do_POST(self):
        try:
            if self.path == "/api/tasks":
                d = self._body()
                if not str(d.get("title", "")).strip():
                    return self._err(400, "title required")
                t = tasklib.create(CTX["shared"], d["title"], team=str(d.get("team", "-")),
                                   status=str(d.get("status", "backlog")), ref=str(d.get("ref", "")),
                                   description=str(d.get("description", "")), criteria=str(d.get("criteria", "")),
                                   by="human", primary=CTX['primary'],
                                   teams=[t['name'] for t in CTX['cfg']['teams'] if t.get('enabled', True)],
                                   **{k: str(d.get(k, '')) for k in ('scope', 'verify', 'decisions', 'depends')})
                if t["status"] == "todo":
                    self._wake(t)
                return self._json(201, t)
            tid = self._tid()
            if tid and self.path.endswith("/comment"):
                d = self._body()
                text = str(d.get("text", "")).strip()
                if not text:
                    return self._err(400, "text required")
                t = tasklib.append_log(CTX["shared"], tid, f"human: {text}")
                if d.get("notify"):
                    notify_primary(f"COMMENT {tid} | new human note — see {self._rel(tid)} ## Log")
                return self._json(200, t)
            self._err(404, "not found")
        except FileNotFoundError:
            self._err(404, "ticket not found")
        except (ValueError, json.JSONDecodeError) as e:
            self._err(400, str(e))

    def do_PATCH(self):
        tid = self._tid()
        if not tid:
            return self._err(404, "not found")
        try:
            d = self._body()
            prev = tasklib.load(CTX["shared"], tid)
            allowed = {k: d[k] for k in tasklib.EDITABLE if k in d}
            if not allowed:
                return self._err(400, "nothing to change")
            t = tasklib.update(CTX["shared"], tid, allowed, primary=CTX['primary'],
                               teams=[t['name'] for t in CTX['cfg']['teams'] if t.get('enabled', True)])
            if t["status"] != prev["status"]:
                if t["status"] == "todo":
                    self._wake(t)
            return self._json(200, t)
        except FileNotFoundError:
            self._err(404, f"{tid} not found")
        except (ValueError, json.JSONDecodeError) as e:
            self._err(400, str(e))

    def do_DELETE(self):
        tid = self._tid()
        if not tid or not tasklib.path_of(CTX["shared"], tid).exists():
            return self._err(404, f"{tid or 'ticket'} not found")
        tasklib.delete(CTX["shared"], tid)
        self._json(200, {"deleted": tid})

    # plumbing
    def _rel(self, tid: str) -> str:
        return f"{CTX['shared']}/tasks/{tid}.md"

    def _wake(self, t: dict):
        notify_primary(f"NEW {t['id']} | {t['title']} — read {self._rel(t['id'])}, refine (team, criteria) and dispatch")

    def _file(self, path: Path, ctype: str):
        try:
            raw = path.read_bytes()
        except OSError:
            return self._err(404, f"missing {path.name}")
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def _sse(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        q = HUB.attach()
        try:
            self.wfile.write(b"retry: 1500\n\n")
            self.wfile.flush()
            while True:
                try:
                    event, data = q.get(timeout=15)
                    self.wfile.write(f"event: {event}\ndata: {data}\n\n".encode())
                except queue.Empty:
                    self.wfile.write(b": ping\n\n")                 # heartbeat, detects dead clients
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            HUB.detach(q)


# ---------- lifecycle --------------------------------------------------------
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", type=Path, required=True, help="the instance directory, .teams/ by default (holds teams.json)")
    ap.add_argument('--config', type=Path, help='exact configuration file')
    ap.add_argument("--port", type=int, default=None, help="override board.port from teams.json (0 = OS-picked)")
    a = ap.parse_args()
    load_ctx(a.root.resolve(), a.config)

    port = a.port if a.port is not None else int(CTX["board"].get("port", 0) or 0)
    class Server(ThreadingHTTPServer):
        daemon_threads = True

        def handle_error(self, request, client_address):        # client disconnects are normal, not tracebacks
            import traceback
            e = sys.exc_info()[1]
            if not isinstance(e, (BrokenPipeError, ConnectionResetError, TimeoutError)):
                traceback.print_exc()

    srv = Server(("127.0.0.1", port), Handler)
    CTX["url"] = f"http://127.0.0.1:{srv.server_address[1]}"

    board_json = CTX["state"] / "board.json"
    board_json.parent.mkdir(exist_ok=True)
    board_json.write_text(json.dumps({"pid": os.getpid(), "port": srv.server_address[1],
                                      "url": CTX["url"], "started": time.strftime("%Y-%m-%dT%H:%M:%S")}, indent=2))

    def bye(*_):
        try:
            if board_json.exists() and json.loads(board_json.read_text()).get("pid") == os.getpid():
                board_json.unlink()
        except (OSError, json.JSONDecodeError):
            pass
        os._exit(0)
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    signal.signal(signal.SIGHUP, bye)            # pane/workspace closed

    threading.Thread(target=watcher, daemon=True).start()
    print(f"teams-board on {CTX['url']} (root {CTX['root']})")
    srv.serve_forever()


if __name__ == "__main__":
    main()
