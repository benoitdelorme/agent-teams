# agent-teams instance — generated by `teams init`
.state/
# a target on another machine is this machine's business (`teams link`)
remote.json
shared/LOG.md
shared/.roster.json
shared/.locks/
shared/PLAN.md
shared/CONTRACTS.md
rules/*.md
!rules/*.local.md
# Tickets are the project's work history. Ignored by default; delete the two lines below to version them.
shared/tasks/*
!shared/tasks/.gitkeep
